---
import { sitio, titular } from '../data/titular';
import EmailContacto from './EmailContacto.astro';
---

<dl>
  <div>
    <dt>Titular</dt>
    <dd><strong>{titular.nombre}</strong></dd>
  </div>
  <div>
    <dt>NIF</dt>
    <dd><strong>{titular.nif}</strong></dd>
  </div>
  <div>
    <dt>Domicilio</dt>
    <dd><strong>{titular.domicilio}</strong></dd>
  </div>
  <div>
    <dt>Correo electrónico</dt>
    <dd><EmailContacto /></dd>
  </div>
  <div>
    <dt>Sitio web</dt>
    <dd><a href={`${sitio.url}/`}>{sitio.url}/</a></dd>
  </div>
</dl>
