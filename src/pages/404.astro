---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada — diashabiles.es"
  description="La página que buscas no existe. Vuelve a la calculadora de días laborables."
>
  <div class="error-page">
    <h1>404</h1>
    <p class="subtitle">Esta página no existe</p>
    <p>Puede que la dirección sea incorrecta o que la página se haya movido.</p>
    <a href="/" class="cta">← Volver a la calculadora</a>
  </div>

  <style>
    .error-page {
      text-align: center;
      padding: 4rem 1rem;
      max-width: 480px;
      margin: 0 auto;
    }
    h1 {
      font-size: 5rem;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 0.25rem;
      line-height: 1;
    }
    .subtitle {
      font-size: 1.4rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }
    p {
      color: var(--color-muted);
      margin-bottom: 1.5rem;
    }
    .cta {
      display: inline-block;
      background: var(--color-primary);
      color: #fff;
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius);
      text-decoration: none;
      font-weight: 600;
      transition: background 0.2s;
    }
    .cta:hover {
      background: var(--color-primary-hover);
    }
  </style>
</Layout>
