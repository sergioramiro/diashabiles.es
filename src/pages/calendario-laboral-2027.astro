---
import Layout from '../layouts/Layout.astro';
import d27 from '../data/festivos-2027.json';

const title = "Festivos 2027: calendario laboral del BOE por comunidad";
const description = "Los festivos de 2027 en España según el BOE: las 9 fiestas comunes, las de cada comunidad con su día de la semana, puentes y festivos en sábado. Con calendario para imprimir.";

function fecha(f: string) {
  const [y, m, d] = f.split('-').map(Number);
  return new Date(y, m - 1, d);
}
const DN = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
const MES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
// 2027 tiene 365 días y empieza en viernes: 52 semanas completas (260 laborables) + el viernes 31 de diciembre.
const DIAS_ENTRE_SEMANA_2027 = 261;

const nacionales = (d27 as any).nacionales.map((e: any) => ({
  fecha: e.fecha,
  nombre: e.nombre,
  dia: DN[fecha(e.fecha).getDay()],
  etiqueta: `${fecha(e.fecha).getDate()} ${MES[fecha(e.fecha).getMonth()]}`,
  nota: e.nota || '',
}));

type Fila = {
  id: string; nombre: string; total: number; efectivos: number;
  sabados: string[]; pendientes: string[]; laborables: number;
};
const filas: Fila[] = Object.entries((d27 as any).comunidades).map(([id, g]: [string, any]) => {
  const unicas = new Map<string, any>();
  for (const e of g.festivos) if (!unicas.has(e.fecha)) unicas.set(e.fecha, e);
  let efectivos = 0;
  const sabados: string[] = [];
  const pendientes: string[] = [];
  for (const e of unicas.values()) {
    const dw = fecha(e.fecha).getDay();
    const etiqueta = `${fecha(e.fecha).getDate()} ${MES[fecha(e.fecha).getMonth()]} ${e.nombre}`;
    if (dw === 6) sabados.push(etiqueta);
    else if (dw === 0) {
      const n = (e.nota || '').toLowerCase();
      const sinConfirmar = /pendiente|provisional|sin confirmar/.test(n);
      const sinTraslado = /no se traslada|no traslada|sin traslado|no figura|no lo incluye|sustituid/.test(n);
      const trasladado = /traslad\w* al lunes|se traslada al lunes/.test(n);
      if (sinConfirmar || (!sinTraslado && !trasladado)) pendientes.push(etiqueta);
    } else efectivos++;
  }
  return { id, nombre: g.nombre, total: unicas.size, efectivos, sabados, pendientes, laborables: DIAS_ENTRE_SEMANA_2027 - efectivos };
});
filas.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

// --- Puentes 2027: se calculan del mismo JSON de festivos, sin datos externos ---
const MESL = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const DNL = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
const clave = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const etiquetaDia = (d: Date) => `${d.getDate()} ${MESL[d.getMonth()]}`;

function puentesDe(g: any) {
  const unicas = new Map<string, string>();
  for (const e of g.festivos) if (!unicas.has(e.fecha)) unicas.set(e.fecha, e.nombre);

  // 1) Tramos de cuatro días o más sin trabajar: festivos + fin de semana, sin gastar vacaciones.
  const libres: string[] = [];
  let tramo: Date[] = [];
  const cierra = () => {
    if (tramo.length >= 4 && tramo.some((d) => unicas.has(clave(d)))) {
      libres.push(`${etiquetaDia(tramo[0])} – ${etiquetaDia(tramo[tramo.length - 1])} (${tramo.length} días)`);
    }
    tramo = [];
  };
  for (let d = new Date(2027, 0, 1, 12); d.getFullYear() === 2027; d.setDate(d.getDate() + 1)) {
    if (d.getDay() === 0 || d.getDay() === 6 || unicas.has(clave(d))) tramo.push(new Date(d));
    else cierra();
  }
  cierra();

  // 2) Festivos en martes o jueves con el día de al lado laborable: puente de cuatro días gastando uno de vacaciones.
  const conDia: string[] = [];
  for (const [f, nombre] of [...unicas.entries()].sort()) {
    const [y, m, dd] = f.split('-').map(Number);
    const d = new Date(y, m - 1, dd, 12);
    const vecino = new Date(d);
    if (d.getDay() === 2) vecino.setDate(vecino.getDate() - 1);
    else if (d.getDay() === 4) vecino.setDate(vecino.getDate() + 1);
    else continue;
    if (vecino.getDay() === 0 || vecino.getDay() === 6 || unicas.has(clave(vecino))) continue;
    conDia.push(`${etiquetaDia(d)} (${nombre.split('(')[0].trim()}, cogiendo el ${DNL[vecino.getDay()]} ${vecino.getDate()})`);
  }
  return { libres, conDia };
}

const puentes = Object.entries((d27 as any).comunidades)
  .map(([id, g]: [string, any]) => ({ id, nombre: g.nombre, ...puentesDe(g) }))
  .sort((a: any, b: any) => a.nombre.localeCompare(b.nombre, 'es'));
---

<Layout title={title} description={description}>
  <Fragment slot="json-ld">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Festivos 2027 en España: calendario laboral oficial por comunidad",
      "description": "Las fiestas nacionales de 2027 con su día de la semana, las nueve comunes a toda España según el BOE y el calendario de cada comunidad autónoma.",
      "author": { "@type": "Person", "name": "Carlos Méndez" },
      "datePublished": "2026-09-28",
      "dateModified": "2026-11-23",
      "publisher": {
        "@type": "Organization",
        "name": "diashabiles.es",
        "url": "https://diashabiles.es"
      },
      "image": "https://diashabiles.es/og-image.png",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://diashabiles.es/calendario-laboral-2027"
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo se publican los festivos 2027 en el BOE?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La resolución de la Dirección General de Trabajo con los festivos de 2027 se publicó en el BOE el 13 de octubre de 2026 (Resolución de 8 de octubre de 2026, BOE-A-2026-21254). La del ejercicio 2026 apareció el 28 de octubre de 2025 (BOE-A-2025-21667)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos festivos nacionales hay en 2027?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Diez: 1 de enero, 6 de enero, Viernes Santo (26 de marzo), 1 de mayo, 15 de agosto, 12 de octubre, 1 de noviembre, 6 de diciembre, 8 de diciembre y 25 de diciembre."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué festivos caen en sábado en 2027?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El 1 de mayo (Día del Trabajo) y el 25 de diciembre (Navidad). No se trasladan ni se recuperan: son dos festivos perdidos en toda España. Cataluña añade el 11 de septiembre y Valencia el 9 de octubre."
          }
        },
        {
          "@type": "Question",
          "name": "¿El 15 de agosto de 2027 es festivo en todo el país?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, el 15 de agosto es festivo nacional, pero en 2027 cae en domingo y el descanso lo decide cada comunidad: Andalucía, Aragón, Asturias, Canarias, Castilla y León y Madrid lo trasladan al lunes 16; Cantabria, Galicia, Castilla-La Mancha y Murcia lo sustituyen por un festivo propio; Extremadura lo traslada al lunes 11 de octubre; y en el resto no se traslada."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <main class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
    <nav class="mb-8 text-sm text-text-secondary">
      <a href="/" class="hover:text-primary transition-colors">Inicio</a>
      <span class="mx-2">·</span>
      <span class="text-on-surface">Calendario laboral 2027</span>
    </nav>

    <article>
      <header class="mb-10">
        <div class="flex items-center gap-2 mb-3 text-sm text-text-secondary">
          <span class="material-symbols-outlined text-[16px]">calendar_today</span>
          <time datetime="2026-10-13">13 de octubre de 2026</time>
          <span class="mx-1">·</span>
          <span>8 min de lectura</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-on-surface leading-tight mb-4">
          Festivos 2027 en España: calendario laboral oficial por comunidad
        </h1>
        <p class="text-sm text-text-secondary mb-4">
          Actualizado el <time datetime="2026-11-20">20 de noviembre de 2026</time>
        </p>
        <p class="text-lg text-text-secondary leading-relaxed">
          Los diez festivos nacionales de 2027, qué día de la semana caen, cuáles se pierden y qué ha confirmado la resolución oficial del BOE.
        </p>
      </header>

      <div class="prose-custom space-y-6 text-on-surface leading-relaxed">
        <p>
          Este calendario sigue la resolución oficial de festivos de 2027, publicada en el BOE el <strong>13 de octubre de 2026</strong> (BOE-A-2026-21254). Los festivos nacionales están fijados por el Estatuto de los Trabajadores y no cambian; los calendarios de cada comunidad autónoma ya estaban publicados en sus boletines oficiales y así aparecen recogidos aquí. La resolución confirma los diecinueve calendarios, incluido el de Asturias, que se incorpora con el descanso de la Asunción trasladado al lunes 16 de agosto.
        </p>

        <p>
          <strong>En resumen.</strong> El BOE del 13 de octubre de 2026 (<a href="https://www.boe.es/diario_boe/txt.php?id=BOE-A-2026-21254" class="text-primary hover:underline" target="_blank" rel="noopener">BOE-A-2026-21254</a>) fija los festivos de 2027. Nueve son comunes a toda España: 1 y 6 de enero, Viernes Santo (26 de marzo), 1 de mayo, 12 de octubre, 1 de noviembre, 6 y 8 de diciembre y 25 de diciembre. El Jueves Santo (25 de marzo) es festivo en todas las comunidades salvo Cataluña y la Comunitat Valenciana. El 15 de agosto cae en domingo: Andalucía, Aragón, Asturias, Canarias, Castilla y León y Madrid trasladan el descanso al lunes 16. El 1 de mayo y el 25 de diciembre caen en sábado.
        </p>

        <h2 class="text-2xl font-bold text-on-surface mt-10 mb-4">Festivos nacionales 2027</h2>
        <p>Estas son las fiestas nacionales de 2027. Nueve se celebran en toda España en el día que les corresponde; la Asunción cae en domingo y cada comunidad decide si traslada su descanso.</p>

        <div class="overflow-x-auto my-8">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-2 border-outline-variant">
                <th class="text-left py-2 font-semibold">Fecha</th>
                <th class="text-left py-2 font-semibold">Día</th>
                <th class="text-left py-2 font-semibold">Festivo</th>
                <th class="text-left py-2 font-semibold">Observaciones</th>
              </tr>
            </thead>
            <tbody>
              {nacionales.map(n => (
                <tr class="border-b border-outline-variant">
                  <td class="py-2 font-semibold">{n.etiqueta}</td>
                  <td class="py-2 capitalize">{n.dia}</td>
                  <td class="py-2">{n.nombre}</td>
                  <td class="py-2 text-text-secondary text-xs">{n.nota || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p>
          Dos caen en sábado (1 de mayo y 25 de diciembre) y no se recuperan: los sábados no admiten traslado. Uno cae en domingo (15 de agosto) y ahí cada comunidad ya se ha pronunciado: seis mueven el descanso al lunes 16 (Andalucía, Aragón, Asturias, Canarias, Castilla y León y Madrid), cuatro lo sustituyen por un festivo propio, Extremadura lo lleva al lunes 11 de octubre y el resto no lo traslada. El resto son días laborables entre semana, así que 2027 es un año con festivos bien repartidos: la Semana Santa del 25 al 29 de marzo abre puente en varias comunidades, y noviembre y diciembre concentran cuatro festivos en siete semanas.
        </p>

        <h2 class="text-2xl font-bold text-on-surface mt-10 mb-4">Reglas: cuándo se recupera un festivo</h2>
        <p>El marco es el artículo 45 del Real Decreto 2001/1983, tal y como lo resume la propia resolución del BOE:</p>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>Fiestas nacionales no sustituibles</strong> (apartados a, b y c del art. 45.1): Año Nuevo, Viernes Santo, 1 de mayo, 12 de octubre, 1 de noviembre, 6 y 25 de diciembre... las comunidades no pueden quitarlas.</li>
          <li><strong>Fiestas nacionales sustituibles</strong> (apartado d): 6 de enero, Jueves Santo y San José o Santiago. Cada comunidad elige si las celebra o las cambia por una tradición propia. Por eso Jueves Santo es festivo en diecisiete comunidades y no en Cataluña ni en la Comunitat Valenciana (en muchas localidades de esas provincias sí es festivo local).</li>
          <li><strong>Fiestas que caen en domingo</strong>: el descanso se traslada al lunes siguiente, salvo que la comunidad sustituya ese lunes por una festividad propia (art. 45.3). En 2026 la diferencia fue real: nueve comunidades disfrutaron del lunes 2 de noviembre y otras no.</li>
          <li><strong>Fiestas que caen en sábado</strong>: no se trasladan ni se recuperan. Es el caso de 2027 con el 1 de mayo y el 25 de diciembre.</li>
        </ul>

        <div class="bg-surface-card rounded-2xl p-6 my-8 border border-border-subtle">
          <h2 class="text-xl font-bold text-on-surface mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">event</span>
            Calculadora de días laborables 2027
          </h2>
          <p class="text-sm text-text-secondary mb-4">Entre dos fechas, con los festivos de tu comunidad: el número exacto de laborables y hábiles del tramo.</p>
          <a href="/#calculadora" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-xl font-semibold text-sm hover:opacity-90 transition-opacity">
            <span class="material-symbols-outlined text-[16px]">calculate</span>
            Calcular
          </a>
        </div>

        <h2 class="text-2xl font-bold text-on-surface mt-10 mb-4">Calendario por comunidad autónoma</h2>
        <p>
          Diecinueve calendarios (diecisiete comunidades y Ceuta y Melilla), con el recuento de festivos de 2027 y cuántos caen en fin de semana. Los de <em>sábado</em> están perdidos; en <em>domingo</em> no queda ninguno por confirmar: la Asunción del 15 de agosto ya está resuelta en las diecinueve, según la resolución del BOE.
        </p>

        <p>
          La cifra que más se consulta es la de <strong>días laborables</strong>, que es lo que añade esta tabla: se obtiene restando de los 261 días de lunes a viernes que hay en 2027 —365 días que empiezan en viernes, es decir 52 semanas completas más el viernes 31 de diciembre— los festivos que caen entre semana. Los sábados y domingos no son laborables de partida, y un festivo que cae en fin de semana no resta nada más. El resultado va de <strong>249 días en Ceuta y Melilla</strong> (las dos con 14 festivos, 12 de ellos entre semana) a <strong>252 en Canarias, Cataluña y la Comunitat Valenciana</strong>; Madrid, con diez festivos de lunes a viernes, se queda en 251. Son días laborables a efectos de calendario: las fiestas locales de cada municipio y los convenios con jornada reducida no están incluidos.
        </p>

        <div class="overflow-x-auto my-8">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-2 border-outline-variant">
                <th class="text-left py-2 font-semibold">Comunidad</th>
                <th class="text-right py-2 font-semibold">Festivos</th>
                <th class="text-right py-2 font-semibold">De lunes a viernes</th>
                <th class="text-right py-2 font-semibold">Días laborables</th>
                <th class="text-right py-2 font-semibold">En sábado (perdidos)</th>
                <th class="text-right py-2 font-semibold">En domingo (sin resolver)</th>
              </tr>
            </thead>
            <tbody>
              {filas.map(f => (
                <tr class="border-b border-outline-variant">
                  <td class="py-2">
                    <a href={`/comunidad/${f.id}/`} class="text-primary hover:underline font-semibold">{f.nombre}</a>
                    {f.id === 'madrid' && (
                      <>
                        {' · '}
                        <a href="/calendario-laboral-madrid-2027/" class="text-primary hover:underline">Festivos Madrid 2027</a>
                      </>
                    )}
                  </td>
                  <td class="py-2 text-right">{f.total}</td>
                  <td class="py-2 text-right">{f.efectivos}</td>
                  <td class="py-2 text-right font-semibold">{f.laborables}</td>
                  <td class="py-2 text-right">{f.sabados.length}</td>
                  <td class="py-2 text-right">{f.pendientes.length}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p>
          El detalle de cada comunidad (con el calendario mes a mes) está en las páginas de cada territorio, por ejemplo <a href="/comunidad/madrid/" class="text-primary hover:underline">Madrid</a>, <a href="/comunidad/cataluna/" class="text-primary hover:underline">Cataluña</a>, <a href="/comunidad/andalucia/" class="text-primary hover:underline">Andalucía</a>, <a href="/comunidad/valencia/" class="text-primary hover:underline">Comunitat Valenciana</a> o <a href="/comunidad/pais_vasco/" class="text-primary hover:underline">País Vasco</a>.
        </p>

        <h2 class="text-2xl font-bold text-on-surface mt-10 mb-4">Puentes de 2027: dónde salen cuatro días seguidos</h2>
        <p>
          Un puente no es un derecho laboral: es lo que sale de juntar un festivo con el fin de semana y, si hace falta, con un día de vacaciones. En 2027 hay dos que se repiten en toda España y unos cuantos que solo existen en algunas comunidades. La tabla de abajo está calculada del mismo calendario de festivos que el resto de la página, sin añadir datos de ningún otro sitio.
        </p>
        <p>
          El más rentable no cuesta ni un día: <strong>la Semana Santa</strong>. El Jueves Santo (25 de marzo) y el Viernes Santo (26) son festivos en diecisiete de las diecinueve comunidades —no en Cataluña ni en la Comunitat Valenciana, donde el Viernes Santo sí es festivo y el Lunes de Pascua (29) cierra el tramo por el otro lado—, así que donde aplica salen cuatro días seguidos de jueves a domingo. Cuatro comunidades lo estiran a cinco con el Lunes de Pascua. El segundo es el <strong>12 de octubre</strong>, que en 2027 cae en martes en las diecinueve: cogiendo el lunes 11 sale un puente de cuatro días. En Extremadura ni eso hace falta, porque el lunes 11 ya es festivo por el traslado de la Asunción, y el tramo va del sábado 9 al martes 12.
        </p>

        <div class="overflow-x-auto my-8">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-2 border-outline-variant">
                <th class="text-left py-2 font-semibold">Comunidad</th>
                <th class="text-left py-2 font-semibold">Cuatro días o más sin gastar vacaciones</th>
                <th class="text-left py-2 font-semibold">Festivo que abre puente gastando un día</th>
              </tr>
            </thead>
            <tbody>
              {puentes.map((p: any) => (
                <tr class="border-b border-outline-variant">
                  <td class="py-2 align-top">
                    <a href={`/comunidad/${p.id}/`} class="text-primary hover:underline font-semibold">{p.nombre}</a>
                  </td>
                  <td class="py-2 align-top text-text-secondary text-xs">{p.libres.length ? p.libres.join(' · ') : '—'}</td>
                  <td class="py-2 align-top text-text-secondary text-xs">{p.conDia.length ? p.conDia.join(' · ') : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p>
          Los puentes que no son de todos: Ceuta suma tres festivos en jueves (5 de agosto, 2 de septiembre y el 12 de octubre), País Vasco tiene el 7 de octubre y Castilla-La Mancha el Corpus del 27 de mayo, y Cataluña el 24 de junio. Los que ya vienen con cuatro días o más sin tocar vacaciones son la Semana Santa de cada comunidad y, en Navarra, el tramo del 3 al 6 de diciembre, que junta San Francisco Javier con la Constitución.
        </p>
        <p>
          Ojo con dos cosas al pedir el día: el calendario laboral fija los festivos, pero no obliga a la empresa a conceder la vacación en la fecha que quieras, y las fiestas locales de tu municipio pueden alargar o romper cualquiera de estos tramos. Si lo que te interesa son los puentes que llegan antes, los de <a href="/puentes-diciembre-2026/" class="text-primary hover:underline">diciembre de 2026</a> están contados día a día.
        </p>
        <h2 class="text-2xl font-bold text-on-surface mt-10 mb-4">Fuentes oficiales</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li><a href="https://www.boe.es/diario_boe/txt.php?id=BOE-A-2026-21254" class="text-primary hover:underline" target="_blank" rel="noopener">Resolución de 8 de octubre de 2026, de la Dirección General de Trabajo, por la que se publica la relación de fiestas laborales para el año 2027 (BOE-A-2026-21254, BOE del 13 de octubre de 2026).</a></li>
          <li><a href="https://www.boe.es/diario_boe/txt.php?id=BOE-A-2026-23826" class="text-primary hover:underline" target="_blank" rel="noopener">Resolución de 5 de noviembre de 2026, de la Secretaría de Estado de Función Pública: calendario de días inhábiles de la AGE para 2027 (BOE-A-2026-23826, BOE del 14 de noviembre de 2026).</a></li>
          <li>Las fiestas locales (dos por municipio) las publica cada comunidad en su boletín oficial y no están en esta página.</li>
        </ul>
        <p>
          Los traslados del 15 de agosto están resueltos en las diecinueve. Andalucía, Aragón, Asturias, Canarias, Castilla y León y Madrid dan el lunes 16; Cantabria (15 de septiembre), Galicia (17 de mayo), Castilla-La Mancha (31 de mayo) y Murcia (9 de junio) lo sustituyen por un festivo propio; Extremadura lo traslada al lunes 11 de octubre; el resto no lo traslada.
        </p>

        <p>
          Si te interesa el efecto de los festivos de fin de semana, el análisis completo —incluido el 11 de septiembre en Cataluña y el 26 de diciembre en Baleares y Cataluña— está en <a href="/festivos-perdidos-2027/" class="text-primary hover:underline">festivos perdidos 2027</a>.
        </p>
        <p>
          Si lo que quieres es el calendario en papel, está en <a href="/calendario-2027-para-imprimir/" class="text-primary hover:underline">calendario 2027 para imprimir</a>: doce meses en A4 con los festivos de tu comunidad marcados.
        </p>
        <p>
          Este calendario es el laboral, el que ordena jornadas y nóminas. Para contar plazos ante la Administración hay un documento aparte, el calendario de días inhábiles, que ya está publicado (BOE del 14 de noviembre de 2026): lo explico en <a href="/dias-inhabiles-2027/" class="text-primary hover:underline">calendario de días inhábiles 2027</a>. Y si lo que buscas es planificar el año siguiente, el <a href="/calendario-laboral-2028/" class="text-primary hover:underline">calendario laboral 2028</a> ya tiene fijadas las diez fiestas nacionales y las fechas en las que se sabrá el resto.
        </p>

        <h2 class="text-2xl font-bold text-on-surface mt-10 mb-4">Preguntas frecuentes</h2>
        <div class="space-y-5">
          <div>
            <h3 class="font-bold text-on-surface">¿Cuándo se publican los festivos 2027 en el BOE?</h3>
            <p class="text-text-secondary">Ya está publicada: salió el 13 de octubre de 2026 (Resolución de 8 de octubre de 2026, BOE-A-2026-21254). El año anterior, la resolución de 2026 apareció el 28 de octubre de 2025.</p>
          </div>
          <div>
            <h3 class="font-bold text-on-surface">¿Cuántos festivos nacionales hay en 2027?</h3>
            <p class="text-text-secondary">Diez, igual que todos los años: 1 de enero, 6 de enero, Viernes Santo, 1 de mayo, 15 de agosto, 12 de octubre, 1 de noviembre, 6 de diciembre, 8 de diciembre y 25 de diciembre.</p>
          </div>
          <div>
            <h3 class="font-bold text-on-surface">¿Qué festivos se pierden en 2027?</h3>
            <p class="text-text-secondary">El 1 de mayo y el 25 de diciembre, ambos en sábado y en toda España. Cataluña suma la Diada (11 de septiembre) y Valencia el 9 de octubre, también en sábado.</p>
          </div>
          <div>
            <h3 class="font-bold text-on-surface">¿Puedo contar con el lunes 16 de agosto?</h3>
            <p class="text-text-secondary">Sólo si tu comunidad lo traslada. Para 2027 dan el lunes 16 Andalucía, Aragón, Asturias, Canarias, Castilla y León y Madrid; Cantabria, Galicia, Castilla-La Mancha y Murcia lo cambian por un festivo propio; Extremadura lo lleva al 11 de octubre; y en el resto no hay puente. Consulta la tabla superior.</p>
          </div>
        </div>
      </div>

