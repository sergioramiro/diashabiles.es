---
import Layout from '../layouts/Layout.astro';
import { COMUNIDADES } from '../lib/calculadora';
---

<Layout
  title="Calculadora de días laborables y hábiles 2027 — diashabiles.es"
  description="Calcula los días laborables y hábiles entre dos fechas para 2027. Incluye festivos nacionales y de tu comunidad o ciudad autónoma. Herramienta gratuita."
>
  <Fragment slot="json-ld">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Calculadora de días laborables 2027",
      "url": "https://diashabiles.es",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "description": "Calcula días laborables y hábiles entre fechas con festivos nacionales y autonómicos",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos días laborables hay en 2027?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En 2027 hay aproximadamente 252 días laborables en España (lunes a viernes sin festivos). El número exacto varía según tu comunidad o ciudad autónoma por los festivos regionales."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la diferencia entre día hábil y laborable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un día laborable es de lunes a viernes que no es festivo. Un día hábil incluye además los sábados no festivos. En plazos administrativos (Ley 39/2015) se cuentan días hábiles, por lo que los sábados sí cuentan salvo que sean festivos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se calculan los días laborables entre dos fechas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Selecciona la fecha de inicio y fin en la calculadora, elige tu comunidad o ciudad autónoma (o solo festivos nacionales) y la herramienta te dará el número de días laborables, días hábiles y festivos en ese rango."
          }
        },
        {
          "@type": "Question",
          "name": "¿Los sábados cuentan como días laborables?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, los sábados no cuentan como días laborables. Sin embargo, en el ámbito administrativo (plazos de la Ley 39/2015), los sábados sí cuentan como días hábiles si no son festivos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo se publican los festivos oficiales de 2027?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los festivos nacionales se publican en el BOE durante el primer semestre. Los festivos autonómicos se publican en los boletines oficiales de cada comunidad, normalmente antes de octubre. Esta web actualiza los datos cuando se publican oficialmente."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <header>
    <h1>Calculadora de días laborables 2027</h1>
    <p>Sabemos cuántos días trabajas. Incluye festivos nacionales y de tu comunidad.</p>
  </header>

  <div class="provisional">
    ⚠️ <strong>Datos provisionales.</strong> El BOE de festivos 2027 se publica en octubre. Los festivos autonómicos son orientativos hasta entonces.
  </div>

  <div class="calculator">
    <form id="calc-form">
      <div class="form-row">
        <div class="form-group">
          <label for="inicio">Fecha inicio</label>
          <input type="date" id="inicio" name="inicio" value="2027-01-01" required />
        </div>
        <div class="form-group">
          <label for="fin">Fecha fin</label>
          <input type="date" id="fin" name="fin" value="2027-12-31" required />
        </div>
      </div>

      <div class="form-group">
        <label for="comunidad">Comunidad autónoma / ciudad</label>
        <select id="comunidad" name="comunidad">
          <option value="">Solo festivos nacionales</option>
          {COMUNIDADES.map(c => (
            <option value={c.id}>{c.nombre}</option>
          ))}
        </select>
      </div>

      <button type="submit">Calcular</button>
    </form>
  </div>

  <div id="results" class="results hidden">
    <h2>Resultado para <span id="res-periodo"></span></h2>

    <div class="result-grid">
      <div class="result-item">
        <div class="number" id="res-laborables">—</div>
        <div class="label">Días laborables</div>
      </div>
      <div class="result-item">
        <div class="number" id="res-habiles">—</div>
        <div class="label">Días hábiles*</div>
      </div>
      <div class="result-item">
        <div class="number" id="res-calendario">—</div>
        <div class="label">Días de calendario</div>
      </div>
    </div>

    <div id="festivos-rango" class="festivos-list hidden">
      <h3>Festivos en el rango seleccionado</h3>
      <ul id="festivos-ul"></ul>
    </div>

    <p style="margin-top: 1rem; font-size: 0.8rem; color: var(--color-muted);">
      * <strong>Días hábiles</strong> incluyen sábados no festivos (ámbito administrativo, 
      <a href="/dias-habiles/" style="color: var(--color-primary);">Ley 39/2015</a>).
      Los días laborables solo cuentan lunes a viernes.
    </p>
  </div>

  <section style="margin-top: 2rem;">
    <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Festivos por comunidad y ciudad autónoma</h2>
    <p style="font-size: 0.9rem; color: var(--color-muted); margin-bottom: 1rem;">
      Consulta los festivos autonómicos de cada comunidad para 2027:
    </p>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem;">
      {COMUNIDADES.map(c => (
        <a href={`/comunidad/${c.id}`} style="display: block; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); text-decoration: none; color: var(--color-text); font-weight: 500; transition: border-color 0.2s;">
          {c.nombre}
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top: 2rem;">
    <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">¿Qué es un día hábil vs laborable?</h2>
    <p style="font-size: 0.9rem; color: var(--color-muted); margin-bottom: 0.5rem;">
      <strong>Día laborable</strong>: lunes a viernes que no es festivo. Es lo que la mayoría de gente entiende por "día de trabajo".
    </p>
    <p style="font-size: 0.9rem; color: var(--color-muted); margin-bottom: 0.5rem;">
      <strong>Día hábil</strong>: incluye además los sábados no festivos. En el ámbito administrativo (plazos de la Ley 39/2015), 
      los sábados cuentan como días hábiles salvo que sean festivos.
    </p>
    <p style="font-size: 0.9rem; color: var(--color-muted);">
      Ejemplo concreto: en enero 2027 hay 21 días laborables pero 25 días hábiles, porque los 4 sábados no son festivos.
    </p>
  </section>

  <section style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
    <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Guía completa: días laborables, días hábiles y días naturales en España</h2>

    <p style="font-size: 0.95rem; color: var(--color-text); margin-bottom: 1.25rem; line-height: 1.7;">
      Si has llegado hasta aquí probablemente tengas un plazo que cumplir, un contrato que redactar o una nómina que revisar. En cualquiera de esos escenarios, la diferencia entre un día laborable, un día hábil y un día natural puede suponer perder o ganar semanas. Vamos a aclarar los conceptos de una vez por todas, con ejemplos reales y las referencias legales de rigor.
    </p>

    <h3 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text);">Día laborable: lunes a viernes sin festivos</h3>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      Un <strong>día laborable</strong> es, en términos sencillos, cualquier día de la semana entre lunes y viernes que no coincida con un festivo. Es el concepto que la mayoría de la gente maneja en su vida cotidiana: los días en los que se va a trabajar, se abren los bancos y las oficinas públicas atienden al público.
    </p>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      En el ámbito laboral español, la jornada laboral se estructura sobre esta base. Los convenios colectivos, los contratos de trabajo y las nóminas se calculan pensando en días laborables. Por ejemplo, si tu contrato establece 30 días naturales de vacaciones, la empresa los convierte en días laborables para planificar tu ausencia.
    </p>

    <h3 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text);">Día hábil: incluye sábados (y los plazos administrativos lo exigen)</h3>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      Aquí es donde la mayoría comete errores. Un <strong>día hábil</strong> incluye todos los días de lunes a sábado que no sean festivos. Sí, has leído bien: los sábados cuentan. Esto no es una opinión, es la ley. La <strong>Ley 39/2015, de 1 de octubre</strong>, del Procedimiento Administrativo Común de las Administraciones Públicas, establece en su artículo 30 que los plazos se expresan en días hábiles, y que <em>se excluyen del cómputo los sábados</em> <strong>solo cuando sean festivos</strong>.
    </p>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      En la práctica, esto significa que si tienes 30 días hábiles para presentar una alegación ante una administración, ese plazo incluye sábados. Si el plazo empieza un lunes, el primer sábado ya suma. Esta distinción es la que separa a quien cumple los plazos de quien los pierde por un error interpretativo.
    </p>

    <h3 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text);">Día natural: el calendario no perdona</h3>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      Un <strong>día natural</strong> es simplemente un día del calendario, sin importar si es festivo, sábado o domingo. El <strong>artículo 5 del Código Civil</strong> establece que <em>«cuando los plazos se cuentan por días, se entiende que éstos son naturales»</em>, salvo disposición expresa en contrario. Es decir, si un contrato dice «plazo de 15 días» sin más precisiones, son 15 días de calendario, festivos incluidos.
    </p>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      Esto es especialmente relevante en contratos civiles y mercantiles. Si firmas un contrato de alquiler con un preaviso de 30 días naturales, no te queda margen por festivos ni fines de semana. El reloj corre sin parar.
    </p>

    <h3 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text);">Cómo calcular los días laborables entre dos fechas: paso a paso</h3>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      Calcular días laborables no es solo contar lunes a viernes. Hay que tener en cuenta los festivos —tanto nacionales como autonómicos y locales— que caen en el rango. Aquí tienes el proceso paso a paso:
    </p>
    <ol style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; padding-left: 1.5rem; line-height: 1.8;">
      <li><strong>Define las fechas de inicio y fin.</strong> El día de inicio se incluye en el cómputo; el día de fin también (a menos que la norma diga lo contrario).</li>
      <li><strong>Identifica los días de la semana.</strong> Los domingos nunca son hábiles. Los sábados son hábiles (pero no laborables) salvo que sean festivos.</li>
      <li><strong>Descuenta los festivos nacionales.</strong> Son los 14 días publicados en el BOE cada año. No cuentan como hábiles ni laborables.</li>
      <li><strong>Descuenta los festivos autonómicos.</strong> Cada comunidad tiene entre 2 y 4 festivos propios. Varían según la región.</li>
      <li><strong>Comprueba los festivos locales.</strong> En municipios con festivo local propio (por ejemplo, el día del patrón), también hay que restarlo.</li>
      <li><strong>Cuenta los días restantes.</strong> Los días hábiles incluyen sábados no festivos. Los laborables, solo lunes a viernes.</li>
    </ol>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 1rem; line-height: 1.7;">
      Utiliza la calculadora que tienes arriba para obtener el resultado exacto. Solo necesitas seleccionar las fechas, elegir tu comunidad o ciudad autónoma y pulsar «Calcular». La herramienta excluye automáticamente los festivos correspondientes.
    </p>

    <h3 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text);">Ejemplos prácticos con fechas reales</h3>

    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1rem;">
      <p style="font-size: 0.95rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
        Ejemplo 1: Plazo administrativo en Madrid (15 marzo — 30 abril 2027)
      </p>
      <p style="font-size: 0.9rem; color: var(--color-muted); line-height: 1.7;">
        Tienes un plazo de 30 días hábiles para presentar un escrito ante el Ayuntamiento de Madrid. Empiezas el 15 de marzo de 2027 (lunes). En este rango cae el Viernes Santo (25 de marzo), festivo nacional. Si cuentas lunes a sábado excluyendo festivos, llegas al día hábil número 30 alrededor del 26 de abril. Si solo hubieras contado lunes a viernes (sin sábados), habrías llegado el 5 de mayo. La diferencia son <strong>9 días</strong>. Un error de este tipo puede acarrear la inadmisión de tu escrito.
      </p>
    </div>

    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1rem;">
      <p style="font-size: 0.95rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
        Ejemplo 2: Contrato de trabajo y vacaciones
      </p>
      <p style="font-size: 0.9rem; color: var(--color-muted); line-height: 1.7;">
        Tu contrato establece 22 días laborables de vacaciones. Si quieres cogerlos entre el 1 de junio y el 30 de junio de 2027, necesitas saber cuántos días laborables hay en ese mes. Junio 2027 tiene 22 días laborables (sin festivos autonómicos). Si en tu comunidad hay algún festivo local en junio, esos días laborables bajan a 21. Es decir, si tu comunidad celebra un festivo adicional en junio, solo podrías disfrutar de 21 días completos de vacación en ese mes — te faltaría un día para agotar las 22 jornadas.
      </p>
    </div>

    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1rem;">
      <p style="font-size: 0.95rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem;">
        Ejemplo 3: Plazo de empresa para contestar un despido
      </p>
      <p style="font-size: 0.9rem; color: var(--color-muted); line-height: 1.7;">
        Si recibes una carta de despido el 10 de diciembre de 2027, tienes 20 días hábiles para impugnarla ante la jurisdicción social (artículo 59.2 del Estatuto de los Trabajadores). Ten en cuenta que el 6 de diciembre (Día de la Constitución), el 8 de diciembre (Inmaculada Concepción) y el 25 de diciembre (Navidad) son festivos nacionales. El 25 de diciembre cae en sábado, pero como es festivo, no cuenta como hábil. Si empiezas a contar desde el 11 de diciembre (primer día hábil tras la recepción), el plazo se extiende hasta principios de enero de 2028. Un abogado laboralista siempre verificaría este cómputo con una herramienta como la que te ofrecemos.
      </p>
    </div>

    <h3 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text);">¿Por qué importa tanto esta distinción?</h3>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      La confusión entre días laborables, hábiles y naturales no es solo un tema académico. Tiene consecuencias reales en múltiples ámbitos:
    </p>

    <h4 style="font-size: 0.95rem; margin-top: 1rem; margin-bottom: 0.5rem; color: var(--color-text);">Plazos administrativos</h4>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      La Ley 39/2015 y su reglamento de desarrollo establecen que los plazos de las administraciones públicas se expresan en días hábiles. Presentar un recurso, una alegación o una solicitud fuera de plazo puede suponer la inadmisión del trámite. Los boletines oficiales (BOE, BOJA, DOGC, etc.) publican periódicamente los calendarios de festivos para que los ciudadanos puedan calcular sus plazos correctamente.
    </p>

    <h4 style="font-size: 0.95rem; margin-top: 1rem; margin-bottom: 0.5rem; color: var(--color-text);">Contratos y obligaciones civiles</h4>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      En contratos privados, si no se especifica nada, el Código Civil presume días naturales. Pero muchas empresas y profesionales incluyen cláusulas con plazos en días laborables (para alinearse con su calendario de trabajo) o en días hábiles (para alinearse con plazos administrativos). Saber cuál aplica es fundamental para no incurrir en incumplimiento contractual.
    </p>

    <h4 style="font-size: 0.95rem; margin-top: 1rem; margin-bottom: 0.5rem; color: var(--color-text);">Recursos humanos y nóminas</h4>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; line-height: 1.7;">
      En el día a día de un departamento de RRHH, saber cuántos días laborables hay en un mes es esencial para calcular nóminas, bonificaciones por presencia, productividad y encuadramiento de convenios. Un festivo caído en martes, por ejemplo, puede alterar el cómputo de horas mensuales si el convenio lo establece. Herramientas como esta calculadora evitan tener que hacerlo manualmente y cometer errores costosos.
    </p>

    <h4 style="font-size: 0.95rem; margin-top: 1rem; margin-bottom: 0.5rem; color: var(--color-text);">Gestión de proyectos y planificación</h4>
    <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 1rem; line-height: 1.7;">
      Si gestionas proyectos con herramientas tipo Jira o Asana, conocer los días laborables del equipo es clave para estimar sprints, compromisos de entrega y capacity planning. Un festivo en mitad de un sprint reduce la capacidad del equipo y puede hacer peligrar un milestone. Los managers que planifican con datos reales —no con suposiciones— son los que cumplen plazos de forma fiable.
    </p>

    <h3 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text);">Referencias legales</h3>
    <ul style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 0.75rem; padding-left: 1.5rem; line-height: 1.8;">
      <li><strong>Ley 39/2015, de 1 de octubre</strong>, del Procedimiento Administrativo Común — art. 30 (cómputo de plazos en días hábiles).</li>
      <li><strong>Artículo 5 del Código Civil</strong> — presunción de días naturales salvo disposición expresa en contrario.</li>
      <li><strong>Real Decreto 2001/2015</strong> — normas de desarrollo del procedimiento administrativo común.</li>
      <li><strong>Artículo 59.2 del Estatuto de los Trabajadores</strong> — plazos de impugnación de despidos en días hábiles.</li>
      <li><strong>BOE (Boletín Oficial del Estado)</strong> — publicación anual de festivos nacionales.</li>
    </ul>

    <p style="font-size: 0.95rem; color: var(--color-muted); line-height: 1.7; margin-top: 1rem;">
      En resumen: no todos los días son iguales ante la ley. Aprender a distinguir entre laborables, hábiles y naturales te dará una ventaja práctica en tu vida profesional y personal. Usa la calculadora de arriba, verifica tus fechas con festivos oficiales y nunca más pierdas un plazo por no haber contado bien los días.
    </p>
  </section>

  <section style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
    <h2 style="font-size: 1.1rem; margin-bottom: 1rem;">Preguntas frecuentes</h2>

    <details style="margin-bottom: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem;">
      <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem;">¿Cuántos días laborables hay en 2027?</summary>
      <p style="margin-top: 0.75rem; font-size: 0.9rem; color: var(--color-muted);">
        En 2027 hay aproximadamente <strong>252 días laborables</strong> en España (lunes a viernes sin festivos). El número exacto varía según tu comunidad o ciudad autónoma por los festivos regionales.
      </p>
    </details>

    <details style="margin-bottom: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem;">
      <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem;">¿Cuál es la diferencia entre día hábil y laborable?</summary>
      <p style="margin-top: 0.75rem; font-size: 0.9rem; color: var(--color-muted);">
        Un <strong>día laborable</strong> es de lunes a viernes que no es festivo. Un <strong>día hábil</strong> incluye además los sábados no festivos. En plazos administrativos (<a href="/dias-habiles/" style="color: var(--color-primary);">Ley 39/2015</a>) se cuentan días hábiles, por lo que los sábados sí cuentan salvo que sean festivos.
      </p>
    </details>

    <details style="margin-bottom: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem;">
      <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem;">¿Cómo se calculan los días laborables entre dos fechas?</summary>
      <p style="margin-top: 0.75rem; font-size: 0.9rem; color: var(--color-muted);">
        Selecciona la fecha de inicio y fin en la calculadora, elige tu comunidad o ciudad autónoma (o solo festivos nacionales) y la herramienta te dará el número de días laborables, días hábiles y festivos en ese rango.
      </p>
    </details>

    <details style="margin-bottom: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem;">
      <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem;">¿Los sábados cuentan como días laborables?</summary>
      <p style="margin-top: 0.75rem; font-size: 0.9rem; color: var(--color-muted);">
        No, los sábados no cuentan como días laborables. Sin embargo, en el ámbito administrativo (plazos de la <a href="/dias-habiles/" style="color: var(--color-primary);">Ley 39/2015</a>), los sábados sí cuentan como días hábiles si no son festivos.
      </p>
    </details>

    <details style="margin-bottom: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem;">
      <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem;">¿Cuándo se publican los festivos oficiales de 2027?</summary>
      <p style="margin-top: 0.75rem; font-size: 0.9rem; color: var(--color-muted);">
        Los festivos nacionales se publican en el BOE durante el primer semestre. Los festivos autonómicos se publican en los boletines oficiales de cada comunidad, normalmente antes de octubre. Esta web actualiza los datos cuando se publican oficialmente.
      </p>
    </details>
  </section>

  <footer>
    <p>diashabiles.es — Festivos nacionales y autonómicos 2027 (provisionales)</p>
    <p style="margin-top: 0.25rem;">
      <a href="/dias-habiles/">¿Qué son los días hábiles?</a> · 
      <a href="/api/2027/nacional.json">API de festivos</a>
    </p>
  </footer>

  <script>
    // Client-side calculator (JSON import for the browser)
    const FESTIVOS_2027 = {
      nacionales: [
        { fecha: "2027-01-01", nombre: "Año Nuevo" },
        { fecha: "2027-01-06", nombre: "Epifanía del Señor" },
        { fecha: "2027-03-25", nombre: "Viernes Santo" },
        { fecha: "2027-05-01", nombre: "Día del Trabajo" },
        { fecha: "2027-08-15", nombre: "Asunción de la Virgen" },
        { fecha: "2027-10-12", nombre: "Fiesta Nacional" },
        { fecha: "2027-11-01", nombre: "Todos los Santos" },
        { fecha: "2027-12-06", nombre: "Día de la Constitución" },
        { fecha: "2027-12-08", nombre: "Inmaculada Concepción" },
        { fecha: "2027-12-25", nombre: "Navidad" }
      ],
      comunidades: {
        andalucia: {
          nombre: "Andalucía",
          festivos: [
            { fecha: "2027-03-01", nombre: "Día de Andalucía (traslado)" },
            { fecha: "2027-08-16", nombre: "Asunción (traslado)" },
            { fecha: "2027-10-12", nombre: "Fiesta Nacional (traslado)" }
          ]
        },
        castilla_y_leon: {
          nombre: "Castilla y León",
          festivos: [
            { fecha: "2027-04-23", nombre: "Día de Castilla y León" },
            { fecha: "2027-08-16", nombre: "Asunción (traslado)" },
            { fecha: "2027-10-12", nombre: "Fiesta Nacional (traslado)" }
          ]
        }
      }
    };

    function obtenerFestivos(comunidad) {
      const mapa = new Map();
      FESTIVOS_2027.nacionales.forEach(f => mapa.set(f.fecha, f));
      if (comunidad && FESTIVOS_2027.comunidades[comunidad]) {
        FESTIVOS_2027.comunidades[comunidad].festivos.forEach(f => mapa.set(f.fecha, f));
      }
      return mapa;
    }

    function formatearFecha(str) {
      const [y, m, d] = str.split('-');
      return `${d}/${m}/${y}`;
    }

    document.getElementById('calc-form').addEventListener('submit', function(e) {
      e.preventDefault();

      const inicio = document.getElementById('inicio').value;
      const fin = document.getElementById('fin').value;
      const comunidad = document.getElementById('comunidad').value;

      if (!inicio || !fin) return;
      if (inicio > fin) {
        alert('La fecha de inicio debe ser anterior a la fecha fin');
        return;
      }

      const festivos = obtenerFestivos(comunidad);
      const fInicio = new Date(inicio + 'T00:00:00');
      const fFin = new Date(fin + 'T00:00:00');

      let laborables = 0;
      let habiles = 0;
      let total = 0;
      const festivosEnRango = [];

      const cursor = new Date(fInicio);
      while (cursor <= fFin) {
        total++;
        const ds = cursor.getDay();
        const yyyy = cursor.getFullYear();
        const mm = String(cursor.getMonth() + 1).padStart(2, '0');
        const dd = String(cursor.getDate()).padStart(2, '0');
        const fechaStr = `${yyyy}-${mm}-${dd}`;
        const esFestivo = festivos.has(fechaStr);

        if (esFestivo) {
          festivosEnRango.push(festivos.get(fechaStr));
        }

        if (ds === 0 || ds === 6) {
          if (ds === 6 && !esFestivo) habiles++;
        } else {
          if (!esFestivo) {
            laborables++;
            habiles++;
          }
        }

        cursor.setDate(cursor.getDate() + 1);
      }

      // Update UI
      document.getElementById('res-periodo').textContent =
        `${formatearFecha(inicio)} — ${formatearFecha(fin)}`;
      document.getElementById('res-laborables').textContent = laborables;
      document.getElementById('res-habiles').textContent = habiles;
      document.getElementById('res-calendario').textContent = total;

      const festivosDiv = document.getElementById('festivos-rango');
      const festivosUl = document.getElementById('festivos-ul');
      festivosUl.innerHTML = '';

      if (festivosEnRango.length > 0) {
        festivosEnRango.forEach(f => {
          const li = document.createElement('li');
          li.textContent = `${formatearFecha(f.fecha)} — ${f.nombre}`;
          festivosUl.appendChild(li);
        });
        festivosDiv.classList.remove('hidden');
      } else {
        festivosDiv.classList.add('hidden');
      }

      document.getElementById('results').classList.remove('hidden');
    });
  </script>
</Layout>
