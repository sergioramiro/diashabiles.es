---
import Layout from '../layouts/Layout.astro';
import { COMUNIDADES } from '../lib/calculadora';
---

<Layout
  title="Calculadora de días laborables y hábiles 2027 — diashabiles.es"
  description="Calcula los días laborables y hábiles entre dos fechas para 2027. Incluye festivos nacionales y de tu comunidad o ciudad autónoma. Herramienta gratuita."
>
  <Fragment slot="json-ld">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Calculadora de días laborables 2027",
      "url": "https://diashabiles.es",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "description": "Calcula días laborables y hábiles entre fechas con festivos nacionales y autonómicos",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos días laborables hay en 2027?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En 2027 hay aproximadamente 252 días laborables en España (lunes a viernes sin festivos). El número exacto varía según tu comunidad o ciudad autónoma por los festivos regionales."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la diferencia entre día hábil y laborable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un día laborable es de lunes a viernes que no es festivo. Un día hábil incluye además los sábados no festivos. En plazos administrativos (Ley 39/2015) se cuentan días hábiles, por lo que los sábados sí cuentan salvo que sean festivos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se calculan los días laborables entre dos fechas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Selecciona la fecha de inicio y fin en la calculadora, elige tu comunidad o ciudad autónoma (o solo festivos nacionales) y la herramienta te dará el número de días laborables, días hábiles y festivos en ese rango."
          }
        },
        {
          "@type": "Question",
          "name": "¿Los sábados cuentan como días laborables?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, los sábados no cuentan como días laborables. Sin embargo, en el ámbito administrativo (plazos de la Ley 39/2015), los sábados sí cuentan como días hábiles si no son festivos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo se publican los festivos oficiales de 2027?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los festivos nacionales se publican en el BOE durante el primer semestre. Los festivos autonómicos se publican en los boletines oficiales de cada comunidad, normalmente antes de octubre. Esta web actualiza los datos cuando se publican oficialmente."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <!-- ===================== FIXED HEADER ===================== -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="h-16 max-w-[72rem] mx-auto px-4 md:px-6 flex items-center justify-between gap-space-md">
      <div class="flex items-center gap-space-sm shrink-0">
        <img alt="Logo diashabiles.es" class="h-10 w-auto object-contain" src="/logo-stitch.png" />
        <span class="hidden xl:inline-flex items-center px-space-xs py-space-2xs rounded-full bg-status-warning-bg text-status-warning-text font-label-sm text-label-sm font-semibold border border-status-warning/30">Calendario BOE 2027 Provisionales</span>
      </div>
      <nav class="hidden lg:flex items-center gap-space-md">
        <a class="transition-colors bg-primary-container text-on-primary font-bold rounded-lg px-space-sm py-space-xs" href="#calculadora">Calculadora</a>
        <a class="text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-colors" href="#habiles-vs-laborables">Días Hábiles vs Laborables</a>
        <a class="text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-colors" href="#festivos-2027-ccaa">Festivos 2027 por CCAA</a>
        <a class="text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-colors" href="#guia-legal">Guía Legal &amp; Plazos</a>
      </nav>
      <div class="flex items-center gap-space-sm">
        <a href="https://boe.es" target="_blank" rel="noopener" class="hidden md:inline-flex px-space-sm py-space-xs rounded-lg bg-surface-container border border-border-subtle text-on-surface-variant hover:text-on-surface font-label-md text-label-md transition-colors items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px]">open_in_new</span>
          Consultar BOE
        </a>
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg hover:bg-surface-container transition-colors" aria-label="Menú">
          <span class="material-symbols-outlined text-[24px]">menu</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Spacer for fixed header -->
  <div class="h-16"></div>

  <main>
    <!-- ===================== HERO + CALCULATOR ===================== -->
    <section class="relative w-full overflow-hidden pb-space-2xl pt-space-md" id="calculadora">
      <!-- Ambient background gradients -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[58rem] h-[28rem] bg-gradient-to-b from-surface-container/60 via-surface-container-low/40 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
      <div class="absolute top-48 -right-32 w-80 h-80 bg-primary-fixed/20 rounded-full blur-2xl pointer-events-none -z-10"></div>

      <div class="max-w-[72rem] mx-auto px-4 md:px-6">
        <!-- Provisional Alert -->
        <div class="mb-space-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-sm p-space-sm sm:px-space-md bg-status-warning-bg/60 border border-status-warning/40 rounded-xl shadow-sm text-status-warning-text">
          <div class="flex items-center gap-space-sm">
            <div class="w-8 h-8 rounded-lg bg-status-warning/20 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-status-warning-text text-[20px]">warning</span>
            </div>
            <p class="font-body-sm text-body-sm font-medium">
              <strong class="font-bold">Datos provisionales 2027:</strong> El calendario del BOE de festivos 2027 se publica en octubre. Los festivos autonómicos se actualizan en tiempo real conforme aparezcan en los respectivos boletines oficiales.
            </p>
          </div>
          <a class="shrink-0 inline-flex items-center gap-1 font-label-sm text-label-sm font-semibold underline hover:opacity-80 transition-opacity" href="#referencias-legales">
            Ver base normativa <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        <!-- Hero Typography -->
        <div class="max-w-3xl mb-space-xl">
          <div class="inline-flex items-center gap-space-xs px-space-sm py-space-2xs rounded-full bg-surface-container-high text-primary font-label-sm text-label-sm font-semibold mb-space-sm">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            Cómputo Certificado conforme a Ley 39/2015 LPACAP
          </div>
          <h1 class="text-display-hero-mobile md:text-display-hero text-on-surface tracking-tight">
            Calculadora de días laborables y hábiles <span class="text-primary">2027</span>
          </h1>
          <p class="mt-space-xs font-body-lg text-body-lg text-on-surface-variant text-balance">
            Sabemos cuántos días trabajas y calculamos tus plazos administrativos con exactitud jurídica. Incluye festivos nacionales y autonómicos de las 17 Comunidades y 2 Ciudades Autónomas de España.
          </p>
        </div>

        <!-- Interactive Calculator -->
        <div class="bg-surface-card rounded-2xl shadow-xl border border-border-subtle p-space-md sm:p-space-xl relative">
          <div class="grid grid-cols-2 lg:grid-cols-12 gap-space-md lg:gap-space-lg items-end">
            <!-- Start Date -->
            <div class="lg:col-span-4 flex flex-col gap-space-2xs">
              <div class="flex items-center justify-between">
                <label class="font-label-md text-label-md text-on-surface flex items-center gap-1" for="fecha-inicio">
                  <span class="material-symbols-outlined text-primary text-[18px]">calendar_today</span>
                  Fecha de inicio
                </label>
                <div class="flex items-center gap-1 text-[11px] text-primary">
                  <button class="hover:underline font-semibold" id="btn-quick-hoy" type="button">Hoy</button>
                  <span>·</span>
                  <button class="hover:underline font-semibold" id="btn-quick-15mar" type="button">15 mar (caso)</button>
                </div>
              </div>
              <input class="w-full h-11 px-space-sm rounded-lg bg-surface-base border border-border-strong text-on-surface font-label-md text-label-md focus:outline-none focus:border-primary focus:bg-surface-card transition-all" id="fecha-inicio" type="date" value="2027-03-15" />
              <span class="font-caption-legal text-caption-legal text-text-muted">Inicia el cómputo oficial a las 00:00h</span>
            </div>

            <!-- End Date -->
            <div class="lg:col-span-4 flex flex-col gap-space-2xs">
              <div class="flex items-center justify-between">
                <label class="font-label-md text-label-md text-on-surface flex items-center gap-1" for="fecha-fin">
                  <span class="material-symbols-outlined text-primary text-[18px]">event</span>
                  Fecha de fin
                </label>
                <div class="flex items-center gap-1 text-[11px] text-primary">
                  <button class="hover:underline font-semibold" id="btn-quick-30apr" type="button">30 abr (caso)</button>
                  <span>·</span>
                  <button class="hover:underline font-semibold" id="btn-quick-plus30" type="button">+30 días</button>
                </div>
              </div>
              <input class="w-full h-11 px-space-sm rounded-lg bg-surface-base border border-border-strong text-on-surface font-label-md text-label-md focus:outline-none focus:border-primary focus:bg-surface-card transition-all" id="fecha-fin" type="date" value="2027-04-30" />
              <span class="font-caption-legal text-caption-legal text-text-muted">Vence el plazo legal a las 23:59h</span>
            </div>

            <!-- Region Select -->
            <div class="lg:col-span-4 flex flex-col gap-space-2xs">
              <label class="font-label-md text-label-md text-on-surface flex items-center gap-1" for="selector-ccaa">
                <span class="material-symbols-outlined text-primary text-[18px]">location_on</span>
                Comunidad autónoma / Ciudad
              </label>
              <div class="relative">
                <select class="w-full h-11 px-space-sm pr-10 rounded-lg bg-surface-base border border-border-strong text-on-surface font-label-md text-label-md appearance-none focus:outline-none focus:border-primary focus:bg-surface-card transition-all cursor-pointer" id="selector-ccaa">
                  <option selected value="madrid">Comunidad de Madrid</option>
                  <option value="nacional">Solo festivos nacionales</option>
                  {COMUNIDADES.map(c => (
                    <option value={c.id}>{c.nombre}</option>
                  ))}
                </select>
                <span class="material-symbols-outlined absolute right-3 top-2.5 text-secondary pointer-events-none text-[20px]">expand_more</span>
              </div>
              <span class="font-caption-legal text-caption-legal text-text-muted">Aplica automáticamente festivos autonómicos</span>
            </div>

            <!-- Buttons -->
            <div class="lg:col-span-12 pt-space-xs flex flex-wrap items-center justify-between gap-space-sm">
              <div class="flex items-center gap-space-sm flex-wrap">
                <span class="font-label-sm text-label-sm text-text-secondary font-semibold">Atajos rápidos:</span>
                <button class="btn-preset px-space-xs py-1 rounded bg-surface-container text-on-secondary-container hover:bg-surface-container-high text-xs font-medium transition-colors" data-preset="15d" type="button">15 días hábiles</button>
                <button class="btn-preset px-space-xs py-1 rounded bg-surface-container text-on-secondary-container hover:bg-surface-container-high text-xs font-medium transition-colors" data-preset="20d" type="button">20 días despido (ET)</button>
                <button class="btn-preset px-space-xs py-1 rounded bg-surface-container text-on-secondary-container hover:bg-surface-container-high text-xs font-medium transition-colors" data-preset="30d" type="button">30 días administrativos</button>
              </div>
              <div class="flex items-center gap-space-sm">
                <button class="px-space-md h-11 rounded-lg border border-border-subtle bg-surface hover:bg-surface-container-low text-on-surface font-label-md text-label-md transition-colors flex items-center gap-1.5" id="btn-limpiar" type="button">
                  <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                  Limpiar
                </button>
                <button class="px-space-xl h-11 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md shadow-md hover:shadow-lg transition-all flex items-center gap-2" id="btn-calcular" type="button">
                  <span class="material-symbols-outlined text-[20px]">calculate</span>
                  Calcular días
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- RESULTS PANEL -->
        <div class="mt-space-xl pt-space-xs" id="panel-resultados">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-xs mb-space-md">
            <div class="flex items-center gap-space-xs">
              <span class="w-3 h-3 rounded-full bg-tertiary"></span>
              <h2 class="font-headline-md text-headline-md text-on-surface" id="resultado-header-text">
                Resultado para Comunidad de Madrid (15 mar 2027 — 30 abr 2027)
              </h2>
            </div>
            <div class="flex items-center gap-space-xs">
              <button class="px-space-sm py-1.5 rounded-lg bg-surface-card border border-border-subtle text-on-surface-variant hover:text-on-surface text-label-sm font-semibold flex items-center gap-1 shadow-sm transition-colors" id="btn-copiar-resumen" type="button">
                <span class="material-symbols-outlined text-[16px]">content_copy</span>
                Copiar informe
              </button>
            </div>
          </div>

          <!-- 3 KPI Cards -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md mb-space-lg">
            <!-- Laborables -->
            <div class="bg-surface-card border border-border-subtle rounded-xl p-space-lg shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between">
              <div class="flex items-start justify-between">
                <div>
                  <span class="font-label-md text-label-md text-text-secondary uppercase tracking-wider block">Días laborables</span>
                  <span class="font-caption-legal text-caption-legal text-text-muted mt-0.5 block">Lunes a viernes no festivos</span>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-status-valid-bg text-status-valid-text font-label-sm text-label-sm font-bold inline-flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span> Laboral / Nómina
                </span>
              </div>
              <div class="my-space-md">
                <div class="flex items-baseline gap-2">
                  <span class="text-metric-display-mobile md:text-metric-display text-on-surface tracking-tight font-display" id="kpi-laborables">33</span>
                  <span class="font-headline-sm text-headline-sm text-text-muted font-normal">jornadas</span>
                </div>
              </div>
              <p class="font-body-sm text-body-sm text-text-secondary">
                Aplicable para cómputo de contratos de trabajo, turnos laborales, horas de convenio y disfrute de vacaciones.
              </p>
            </div>

            <!-- Hábiles -->
            <div class="bg-surface-card border-2 border-primary-container/40 rounded-xl p-space-lg shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between">
              <div class="absolute top-0 right-0 w-24 h-24 bg-primary-fixed/30 rounded-bl-full pointer-events-none"></div>
              <div class="flex items-start justify-between relative z-10">
                <div>
                  <span class="font-label-md text-label-md text-primary font-bold uppercase tracking-wider block">Días hábiles*</span>
                  <span class="font-caption-legal text-caption-legal text-text-muted mt-0.5 block">Incluye sábados no festivos</span>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm font-bold inline-flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px]">gavel</span> Ley 39/2015
                </span>
              </div>
              <div class="my-space-md relative z-10">
                <div class="flex items-baseline gap-2">
                  <span class="text-metric-display-mobile md:text-metric-display text-primary tracking-tight font-display" id="kpi-habiles">39</span>
                  <span class="font-headline-sm text-headline-sm text-primary/70 font-semibold">días hábiles</span>
                </div>
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant relative z-10">
                Cómputo legal imperativo para plazos de recursos administrativos, solicitudes, oposiciones y requerimientos ante la Administración.
              </p>
            </div>

            <!-- Naturales -->
            <div class="bg-surface-card border border-border-subtle rounded-xl p-space-lg shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
              <div class="flex items-start justify-between">
                <div>
                  <span class="font-label-md text-label-md text-text-secondary uppercase tracking-wider block">Días naturales</span>
                  <span class="font-caption-legal text-caption-legal text-text-muted mt-0.5 block">Días corridos de calendario</span>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-surface-container text-on-secondary-container font-label-sm text-label-sm font-bold">
                  Código Civil art. 5
                </span>
              </div>
              <div class="my-space-md">
                <div class="flex items-baseline gap-2">
                  <span class="text-metric-display-mobile md:text-metric-display text-on-surface tracking-tight font-display" id="kpi-naturales">47</span>
                  <span class="font-headline-sm text-headline-sm text-text-muted font-normal">días totales</span>
                </div>
              </div>
              <p class="font-body-sm text-body-sm text-text-secondary">
                Sin exclusiones. Utilizado en contratos de arrendamiento, plazos mercantiles civiles, prescripciones y fianzas.
              </p>
            </div>
          </div>

          <!-- Mini Calendar Visualization -->
          <div id="mini-calendar-container" class="bg-surface-card rounded-2xl border border-border-subtle p-space-lg shadow-sm">
            <!-- Dynamically rendered by JS -->
          </div>

          <!-- Festivos en rango -->
          <div class="bg-surface-container-low rounded-xl p-space-md border border-border-subtle flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md">
            <div class="flex items-center gap-space-sm">
              <div class="w-10 h-10 rounded-lg bg-surface-card border border-border-subtle flex items-center justify-center text-primary shrink-0 shadow-sm">
                <span class="material-symbols-outlined">event_busy</span>
              </div>
              <div>
                <span class="font-label-md text-label-md text-on-surface font-bold" id="festivos-count-label">Festivos oficiales detectados en el rango:</span>
                <p class="font-caption-legal text-caption-legal text-on-surface-variant">Ambos festivos se descuentan de los días laborables y hábiles.</p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-space-xs" id="festivos-tags-container">
              <!-- Dynamic festivos tags will be inserted here -->
            </div>
          </div>

          <div class="mt-space-xs text-right">
            <p class="font-caption-legal text-caption-legal text-text-muted">
              * <strong class="text-on-surface-variant">Días hábiles</strong> incluyen sábados no festivos (ámbito administrativo, <a class="text-primary underline" href="#guia-legal">Ley 39/2015 LPACAP</a>). Los días laborables solo cuentan lunes a viernes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== HÁBIL VS LABORABLE SECTION ===================== -->
    <section class="w-full bg-surface-base border-y border-border-subtle py-space-xl" id="habiles-vs-laborables">
      <div class="max-w-[72rem] mx-auto px-4 md:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
          <div class="lg:col-span-5">
            <div class="inline-flex items-center gap-1.5 px-space-xs py-1 rounded-md bg-surface-container-high text-primary font-label-sm text-label-sm font-semibold mb-space-xs">
              <span class="material-symbols-outlined text-[16px]">balance</span>
              Criterio Legal Oficial
            </div>
            <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
              ¿Por qué un día hábil NO es lo mismo que un día laborable?
            </h2>
            <p class="mt-space-xs font-body-md text-body-md text-on-surface-variant">
              En España existen tres formas de contar el tiempo. Una confusión entre cómputo procesal administrativo y cómputo laboral puede causar la inadmisión de un recurso o la caducidad de una acción judicial.
            </p>
            <div class="mt-space-md flex items-center gap-space-lg">
              <div>
                <span class="block font-headline-sm text-headline-sm font-bold text-on-surface">Ley 39/2015</span>
                <span class="font-caption-legal text-caption-legal text-text-muted">Art. 30 Administración</span>
              </div>
              <div class="h-8 w-[1px] bg-border-strong"></div>
              <div>
                <span class="block font-headline-sm text-headline-sm font-bold text-on-surface">Código Civil</span>
                <span class="font-caption-legal text-caption-legal text-text-muted">Art. 5 Regla general</span>
              </div>
              <div class="h-8 w-[1px] bg-border-strong"></div>
              <div>
                <span class="block font-headline-sm text-headline-sm font-bold text-on-surface">E.T. Art 59.2</span>
                <span class="font-caption-legal text-caption-legal text-text-muted">Plazos Jurisdicción Social</span>
              </div>
            </div>
          </div>

          <!-- Weekly Matrix -->
          <div class="lg:col-span-7 bg-surface-card rounded-2xl p-space-lg border border-border-subtle shadow-sm">
            <div class="flex items-center justify-between pb-space-sm border-b border-border-subtle mb-space-md">
              <span class="font-label-md text-label-md text-on-surface font-bold">Esquema comparativo semanal</span>
              <span class="font-caption-legal text-caption-legal text-text-muted">Ejemplo semana ordinaria sin festivo</span>
            </div>
            <div class="grid grid-cols-7 gap-2 text-center mb-space-md">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm font-bold text-on-surface">L</span>
                <div class="mt-1 h-9 rounded bg-primary text-on-primary flex items-center justify-center font-bold text-xs">Laboral</div>
                <div class="mt-1 h-9 rounded bg-primary text-on-primary flex items-center justify-center font-bold text-xs">Hábil</div>
                <div class="mt-1 h-9 rounded bg-secondary-container text-on-secondary-fixed flex items-center justify-center font-bold text-xs">Natural</div>
              </div>
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm font-bold text-on-surface">M</span>
                <div class="mt-1 h-9 rounded bg-primary text-on-primary flex items-center justify-center font-bold text-xs">Laboral</div>
                <div class="mt-1 h-9 rounded bg-primary text-on-primary flex items-center justify-center font-bold text-xs">Hábil</div>
                <div class="mt-1 h-9 rounded bg-secondary-container text-on-secondary-fixed flex items-center justify-center font-bold text-xs">Natural</div>
              </div>
              <div class="flex flex-col">
