  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const inputInicio = document.getElementById('fecha-inicio') as HTMLInputElement;
      const inputFin = document.getElementById('fecha-fin') as HTMLInputElement;
      const selectCcaa = document.getElementById('selector-ccaa') as HTMLSelectElement;
      const btnCalcular = document.getElementById('btn-calcular')!;
      const btnLimpiar = document.getElementById('btn-limpiar')!;
      const headerText = document.getElementById('resultado-header-text')!;
      const kpiLaborables = document.getElementById('kpi-laborables')!;
      const kpiHabiles = document.getElementById('kpi-habiles')!;
      const kpiNaturales = document.getElementById('kpi-naturales')!;
      const btnCopiar = document.getElementById('btn-copiar-resumen')!;
      const festivosCountLabel = document.getElementById('festivos-count-label')!;
      const festivosTagsContainer = document.getElementById('festivos-tags-container')!;

      // Check URL params for community
      const urlParams = new URLSearchParams(window.location.search);
      const comunidadParam = urlParams.get('comunidad');
      if (comunidadParam && selectCcaa) {
        selectCcaa.value = comunidadParam;
      }

      const meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

      const festivosNacionales2027 = [
        '2027-01-01', '2027-01-06', '2027-03-26', '2027-05-01',
        '2027-08-15', '2027-10-12', '2027-11-01', '2027-12-06',
        '2027-12-08', '2027-12-25'
      ];

      const festivosAutonomicos2027: Record<string, string[]> = {
        'madrid': ['2027-03-25', '2027-05-02'],
        'andalucia': ['2027-02-28', '2027-03-25'],
        'cataluna': ['2027-03-29', '2027-06-24', '2027-09-11', '2027-12-26'],
        'valencia': ['2027-03-19', '2027-03-29', '2027-10-09'],
        'paisvasco': ['2027-03-25', '2027-03-29']
      };

      const festivosNombres2027: Record<string, string> = {
        '2027-01-01': 'Año Nuevo', '2027-01-06': 'Epifanía', '2027-03-25': 'Jueves Santo',
        '2027-03-26': 'Viernes Santo', '2027-05-01': 'Día del Trabajo', '2027-05-02': 'Fiesta Comunidad Madrid',
        '2027-08-15': 'Asunción', '2027-10-12': 'Fiesta Nacional', '2027-11-01': 'Todos los Santos',
        '2027-12-06': 'Constitución', '2027-12-08': 'Inmaculada', '2027-12-25': 'Navidad',
        '2027-02-28': 'Día de Andalucía', '2027-03-29': 'Lunes de Pascua',
        '2027-06-24': 'Sant Joan', '2027-09-11': 'Diada', '2027-12-26': 'Sant Esteve',
        '2027-03-19': 'San José', '2027-10-09': 'Día de Valencia'
      };

      function computeDays() {
        const startVal = inputInicio.value;
        const endVal = inputFin.value;
        const ccaaVal = selectCcaa.value;
        const ccaaName = selectCcaa.options[selectCcaa.selectedIndex].text;

        if (!startVal || !endVal) return;
        const startDate = new Date(startVal + 'T00:00:00');
        const endDate = new Date(endVal + 'T00:00:00');
        if (endDate < startDate) {
          alert('La fecha de fin no puede ser anterior a la fecha de inicio.');
          return;
        }

        const activeRegionHolidays = festivosAutonomicos2027[ccaaVal] || [];
        const allHolidays = new Set([...festivosNacionales2027, ...activeRegionHolidays]);

        let naturales = 0, laborables = 0, habiles = 0;
        const festivosEnRango: { fecha: string; nombre: string; tipo: string }[] = [];
        const curDate = new Date(startDate);

        while (curDate <= endDate) {
          naturales++;
          const dayOfWeek = curDate.getDay();
          const isoDate = curDate.toISOString().split('T')[0];
          const isHoliday = allHolidays.has(isoDate);

          if (isHoliday) {
            const isAuto = activeRegionHolidays.includes(isoDate);
            festivosEnRango.push({
              fecha: isoDate,
              nombre: festivosNombres2027[isoDate] || 'Festivo',
              tipo: isAuto ? 'Autonómico' : 'Nacional'
            });
          }

          if (dayOfWeek >= 1 && dayOfWeek <= 5 && !isHoliday) laborables++;
          if (dayOfWeek >= 1 && dayOfWeek <= 6 && !isHoliday) habiles++;
          curDate.setDate(curDate.getDate() + 1);
        }

        kpiLaborables.textContent = String(laborables);
        kpiHabiles.textContent = String(habiles);
        kpiNaturales.textContent = String(naturales);

        const sDay = startDate.getDate();
        const sMonth = meses[startDate.getMonth()];
        const sYear = startDate.getFullYear();
        const eDay = endDate.getDate();
        const eMonth = meses[endDate.getMonth()];
        const eYear = endDate.getFullYear();

        headerText.textContent = `Resultado para ${ccaaName} (${sDay} ${sMonth} ${sYear} — ${eDay} ${eMonth} ${eYear})`;

        // Festivos tags
        festivosCountLabel.textContent = `Festivos oficiales detectados en el rango (${festivosEnRango.length} días):`;
        festivosTagsContainer.innerHTML = festivosEnRango.map(f => {
          const fecha = new Date(f.fecha + 'T00:00:00');
          const dia = fecha.getDate();
          const mes = meses[fecha.getMonth()];
          const isAuto = f.tipo === 'Autonómico';
          const borderColor = isAuto ? 'border-status-warning/40' : 'border-error/30';
          const dotColor = isAuto ? 'bg-status-warning' : 'bg-error';
          const badgeBg = isAuto ? 'bg-surface-container' : 'bg-error-container';
          const badgeText = isAuto ? 'text-secondary' : 'text-on-error-container';
          return `
            <div class="inline-flex items-center gap-2 px-space-sm py-1 rounded-lg bg-surface-card border ${borderColor} text-on-surface text-label-sm font-medium shadow-2xs">
              <span class="w-2 h-2 rounded-full ${dotColor}"></span>
              <span><strong>${dia} de ${mes}</strong>: ${f.nombre}</span>
              <span class="text-[10px] px-1.5 py-0.5 ${badgeBg} ${badgeText} rounded font-bold uppercase">${f.tipo}</span>
            </div>
          `;
        }).join('');

        renderMiniCalendar(startDate, endDate, allHolidays, activeRegionHolidays);
      }

      function renderMiniCalendar(startDate: Date, endDate: Date, allHolidays: Set<string>, regionHolidays: string[]) {
        const container = document.getElementById('mini-calendar-container');
        if (!container) return;

        // Determine months in range
        const months: { year: number; month: number; label: string }[] = [];
        const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        const shortMonths = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

        let cur = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
        const endMonth = new Date(endDate.getFullYear(), endDate.getMonth(), 1);
        while (cur <= endMonth) {
          months.push({ year: cur.getFullYear(), month: cur.getMonth(), label: monthNames[cur.getMonth()] });
          cur.setMonth(cur.getMonth() + 1);
        }

        // Count days in range
        const dayCount = Math.round((endDate.getTime() - startDate.getTime()) / 86400000) + 1;
        const ccaaName = selectCcaa.options[selectCcaa.selectedIndex].text;

        // Build header
        const startLabel = `${startDate.getDate()} ${shortMonths[startDate.getMonth()]} ${startDate.getFullYear()}`;
        const endLabel = `${endDate.getDate()} ${shortMonths[endDate.getMonth()]} ${endDate.getFullYear()}`;

        let html = `
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-sm pb-space-md border-b border-border-subtle mb-space-md">
            <div>
              <div class="flex items-center gap-space-xs">
                <span class="material-symbols-outlined text-primary text-[20px]">date_range</span>
                <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">Visualización de calendario interactivo</h3>
                <span class="px-2 py-0.5 rounded-full bg-primary-fixed/30 text-primary font-label-sm text-label-sm font-semibold">${months.length} ${months.length === 1 ? 'mes' : 'meses'} en rango</span>
              </div>
              <p class="font-body-sm text-body-sm text-text-secondary mt-0.5">Rango activo: ${startLabel} — ${endLabel} (${dayCount} días) · ${ccaaName}</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-surface-container-low border border-primary/40 text-on-surface text-xs font-medium">
                <span class="w-2.5 h-2.5 rounded bg-primary-fixed border border-primary"></span><span>En rango</span>
              </div>
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-error-container/40 border border-error/30 text-on-surface text-xs font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-error"></span><span>Festivo</span>
              </div>
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-surface-base border border-border-subtle text-text-secondary text-xs font-medium">
                <span class="w-2.5 h-2.5 rounded bg-surface-container"></span><span>Fin de semana</span>
              </div>
              <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-primary-fixed/10 border border-primary/30 text-primary text-xs font-medium">
                <span class="w-2.5 h-2.5 rounded border border-dashed border-primary text-[9px] flex items-center justify-center font-bold">S</span><span>Sábado hábil (LPACAP)</span>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 ${months.length > 1 ? 'md:grid-cols-' + Math.min(months.length, 3) : ''} gap-space-lg">
        `;

        // Render each month
        for (const m of months) {
          const firstDay = new Date(m.year, m.month, 1);
          const daysInMonth = new Date(m.year, m.month + 1, 0).getDate();
          const startDow = (firstDay.getDay() + 6) % 7; // Monday=0

          // Count range days and holidays in this month
          let rangeDays = 0;
          let monthHolidays: number[] = [];
          let laborables = 0;
          let habiles = 0;

          for (let d = 1; d <= daysInMonth; d++) {
            const dateObj = new Date(m.year, m.month, d);
            const isoDate = `${m.year}-${String(m.month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            const inRange = dateObj >= startDate && dateObj <= endDate;
            if (inRange) {
              rangeDays++;
              const dow = dateObj.getDay();
              const isHoliday = allHolidays.has(isoDate);
              if (!isHoliday && dow >= 1 && dow <= 5) laborables++;
              if (!isHoliday && dow >= 1 && dow <= 6) habiles++;
              if (isHoliday) monthHolidays.push(d);
            }
          }

          const monthHolidaysNames: string[] = [];
          for (const d of monthHolidays) {
            const isoDate = `${m.year}-${String(m.month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            monthHolidaysNames.push(festivosNombres2027[isoDate] || 'Festivo');
          }

          const badgeBg = rangeDays === daysInMonth ? 'bg-primary text-on-primary' : 'bg-primary-container text-on-primary';
          const badgeText = rangeDays === daysInMonth ? `${daysInMonth} días en rango (mes completo)` : `${rangeDays} días en rango`;

          html += `
            <div class="bg-surface-base rounded-xl p-space-md border border-border-subtle">
              <div class="flex items-center justify-between pb-space-xs border-b border-border-subtle mb-space-sm">
                <div class="flex items-center gap-space-xs">
                  <span class="font-label-md text-label-md font-bold text-on-surface">${m.label} ${m.year}</span>
                  <span class="px-1.5 py-0.5 rounded ${badgeBg} text-[10px] font-bold">${badgeText}</span>
                </div>
                <span class="text-caption-legal text-caption-legal text-text-muted">${monthHolidays.length} festivo${monthHolidays.length !== 1 ? 's' : ''}${monthHolidaysNames.length > 0 ? ' (' + monthHolidaysNames.join(', ') + ')' : ''}</span>
              </div>
              <div class="grid grid-cols-7 gap-1 text-center font-label-sm text-caption-legal font-bold text-text-secondary mb-1">
                <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span class="text-primary">S</span><span class="text-error">D</span>
              </div>
              <div class="grid grid-cols-7 gap-1 text-xs text-center">
          `;

          // Empty cells before first day
          for (let i = 0; i < startDow; i++) {
            html += `<div class="p-1.5 rounded text-transparent"></div>`;
          }

          // Day cells
          for (let d = 1; d <= daysInMonth; d++) {
            const dateObj = new Date(m.year, m.month, d);
            const isoDate = `${m.year}-${String(m.month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            const inRange = dateObj >= startDate && dateObj <= endDate;
            const dow = dateObj.getDay(); // 0=Sun, 6=Sat
            const isWeekend = dow === 0 || dow === 6;
            const isSaturday = dow === 6;
            const isSunday = dow === 0;
            const isHoliday = allHolidays.has(isoDate);
            const isStartDate = dateObj.getTime() === startDate.getTime();
            const isEndDate = dateObj.getTime() === endDate.getTime();

            let cellClass = 'p-1.5 rounded ';

            if (!inRange) {
              cellClass += 'text-text-muted bg-surface-card opacity-50';
            } else if (isHoliday) {
              cellClass += 'bg-error-container border border-error/30 text-error font-bold relative group cursor-pointer';
            } else if (isStartDate || isEndDate) {
              cellClass += 'font-bold bg-primary text-on-primary shadow-sm relative group cursor-pointer';
            } else if (isSaturday) {
              cellClass += 'bg-surface-container text-primary font-semibold border border-dashed border-primary/40 relative hover:bg-primary-fixed/20 transition-colors';
            } else if (isSunday) {
              cellClass += 'bg-secondary-container/40 text-text-secondary';
            } else {
              cellClass += 'bg-primary-fixed/30 text-on-surface font-medium hover:bg-primary-fixed/50 transition-colors';
            }

            let dotHtml = '';
            if (isHoliday && inRange) {
              dotHtml = `<span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-error"></span>`;
            } else if (isStartDate && inRange) {
              dotHtml = `<span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-tertiary-fixed"></span>`;
            } else if (isEndDate && inRange) {
              dotHtml = `<span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-error-container"></span>`;
            }

            html += `<div class="${cellClass}">${d}${dotHtml}</div>`;
          }

          html += `
              </div>
              <div class="mt-space-xs pt-space-xs border-t border-border-subtle flex items-center justify-between text-caption-legal text-text-muted">
                <span>${rangeDays > 0 ? (startDate.getMonth() === m.month && startDate.getFullYear() === m.year ? 'Inicio de cómputo: ' + ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'][startDate.getDay()] + ' ' + startDate.getDate() + ' ' + shortMonths[startDate.getMonth()] : rangeDays === daysInMonth ? 'Mes completo en rango' : `${rangeDays} días en rango`) : 'Sin días en rango'}</span>
                <span class="text-primary font-semibold">${laborables} laborables · ${habiles} hábiles</span>
              </div>
            </div>
          `;
        }

        html += `</div>`;

        // Footer info
        html += `
          <div class="mt-space-md pt-space-xs border-t border-border-subtle flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-xs">
            <div class="flex items-center gap-space-xs text-xs text-text-secondary">
              <span class="material-symbols-outlined text-primary text-[18px]">info</span>
              <span>Pasa el cursor por los días festivos para verificar la condición jurídica de cada festivo.</span>
            </div>
            <div class="flex items-center gap-1 text-xs text-text-secondary">
              <span class="font-medium">Visualización dinámica:</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface font-semibold">Rango ${months.length}-${months.length} ${months.length === 1 ? 'mes' : 'meses'} activo</span>
              <span class="text-text-muted">· Vista adaptativa a selección</span>
            </div>
          </div>
        `;

        container.innerHTML = html;
      }

      // Event handlers
      btnCalcular.addEventListener('click', function() {
        btnCalcular.classList.add('scale-95');
        setTimeout(() => {
          btnCalcular.classList.remove('scale-95');
          computeDays();
        }, 120);
      });

      btnLimpiar.addEventListener('click', function() {
        inputInicio.value = '2027-01-01';
        inputFin.value = '2027-01-31';
        selectCcaa.value = 'nacional';
        computeDays();
      });

      // Quick date buttons
      document.getElementById('btn-quick-hoy')?.addEventListener('click', () => {
        const today = new Date();
        const yyyy = '2027';
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');
        inputInicio.value = `${yyyy}-${mm}-${dd}`;
      });

      document.getElementById('btn-quick-15mar')?.addEventListener('click', () => {
        inputInicio.value = '2027-03-15';
      });

      document.getElementById('btn-quick-30apr')?.addEventListener('click', () => {
        inputFin.value = '2027-04-30';
      });

      document.getElementById('btn-quick-plus30')?.addEventListener('click', () => {
        if (!inputInicio.value) return;
        const cur = new Date(inputInicio.value + 'T00:00:00');
        cur.setDate(cur.getDate() + 30);
        inputFin.value = cur.toISOString().split('T')[0];
        computeDays();
      });

      // Quick presets
      document.querySelectorAll('.btn-preset').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const type = (e.target as HTMLElement).dataset.preset;
          inputInicio.value = '2027-03-15';
          if (type === '15d') inputFin.value = '2027-04-03';
          else if (type === '20d') inputFin.value = '2027-04-09';
          else if (type === '30d') inputFin.value = '2027-04-26';
          computeDays();
        });
      });

      // Copy summary
      btnCopiar.addEventListener('click', () => {
        const textToCopy = `Informe Oficial diashabiles.es 2027\n${headerText.textContent}\n- Días laborables: ${kpiLaborables.textContent}\n- Días hábiles (Ley 39/2015): ${kpiHabiles.textContent}\n- Días naturales: ${kpiNaturales.textContent}`;
        navigator.clipboard.writeText(textToCopy).then(() => {
          const original = btnCopiar.innerHTML;
          btnCopiar.innerHTML = `<span class="material-symbols-outlined text-[16px] text-tertiary">check</span> Copiado`;
          setTimeout(() => { btnCopiar.innerHTML = original; }, 2000);
        });
      });

      // FAQ Accordion
      document.querySelectorAll('.faq-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const content = btn.nextElementSibling;
          const icon = btn.querySelector('.faq-icon');
          const isExpanded = content?.classList.contains('expanded');
          if (isExpanded) {
            content?.classList.remove('expanded');
            icon?.classList.remove('rotate-180');
          } else {
            content?.classList.add('expanded');
            icon?.classList.add('rotate-180');
          }
        });
      });

      // Mobile menu
      document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
        // Simple scroll to calculator on mobile
        document.getElementById('calculadora')?.scrollIntoView({ behavior: 'smooth' });
      });

      // Initial computation
      computeDays();
    });
  </script>
</Layout>
