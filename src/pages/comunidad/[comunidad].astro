---
import Layout from '../../layouts/Layout.astro';
import { calcularDias, COMUNIDADES } from '../../lib/calculadora';

export function getStaticPaths() {
  return COMUNIDADES.map(c => ({
    params: { comunidad: c.id },
    props: { nombre: c.nombre, id: c.id },
  }));
}

const { nombre, id } = Astro.props;

const resultado = calcularDias('2027-01-01', '2027-12-31', id);
const festivos = resultado.festivosEnRango;

const soloNacionales = calcularDias('2027-01-01', '2027-12-31');
const festivosAutonomicos = festivos.filter(f => !soloNacionales.festivosEnRango.some(n => n.fecha === f.fecha));

const siglas: Record<string, string> = {
  andalucia: 'AN', aragon: 'AR', asturias: 'AS', baleares: 'IB', canarias: 'CN',
  cantabria: 'CB', castillaleon: 'CL', castillamancha: 'CM', cataluna: 'CT',
  ceuta: 'CE', extremadura: 'EX', galicia: 'GA', madrid: 'MD', melilla: 'ML',
  murcia: 'MC', navarra: 'NC', paisvasco: 'PV', larioja: 'LR', valencia: 'VC',
  nacional: 'NA'
};
const sigla = siglas[id] || id.slice(0, 2).toUpperCase();
---

<Layout
  title={`Días laborables y festivos ${nombre} 2027 — diashabiles.es`}
  description={`Calcula los días laborables y hábiles en ${nombre} para 2027. Festivos nacionales y autonómicos. Herramienta gratuita.`}
>
  <Fragment slot="json-ld">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": `Días laborables ${nombre} 2027`,
      "url": `https://diashabiles.es/comunidad/${id}`,
      "description": `Festivos nacionales y autonómicos de ${nombre} en 2027`,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://diashabiles.es" },
          { "@type": "ListItem", "position": 2, "name": `${nombre}`, "item": `https://diashabiles.es/comunidad/${id}` }
        ]
      }
    }
    </script>
  </Fragment>

  <!-- Fixed Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="h-16 max-w-[72rem] mx-auto px-4 md:px-6 flex items-center justify-between gap-space-md">
      <div class="flex items-center gap-space-sm shrink-0">
        <a href="/" class="flex items-center gap-space-sm no-underline">
          <img alt="Logo diashabiles.es" class="h-10 w-auto object-contain" src="/logo-stitch.png" />
        </a>
      </div>
      <a href="/" class="inline-flex items-center gap-1.5 px-space-sm py-space-xs rounded-lg bg-primary-container text-on-primary font-label-md text-label-md transition-colors">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        Volver a calculadora
      </a>
    </div>
  </header>

  <div class="h-16"></div>

  <main>
    <!-- Breadcrumb -->
    <div class="max-w-[72rem] mx-auto px-gutter-desktop pt-space-lg">
      <nav class="font-body-sm text-body-sm text-text-muted flex items-center gap-1">
        <a href="/" class="text-primary hover:underline no-underline">Inicio</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-on-surface font-semibold">{nombre}</span>
      </nav>
    </div>

    <!-- Hero -->
    <section class="relative w-full overflow-hidden pb-space-2xl pt-space-md">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[58rem] h-[28rem] bg-gradient-to-b from-surface-container/60 via-surface-container-low/40 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
      <div class="max-w-[72rem] mx-auto px-gutter-desktop">
        <!-- Provisional Alert -->
        <div class="mb-space-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-sm p-space-sm sm:px-space-md bg-status-warning-bg/60 border border-status-warning/40 rounded-xl shadow-sm text-status-warning-text">
          <div class="flex items-center gap-space-sm">
            <div class="w-8 h-8 rounded-lg bg-status-warning/20 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-status-warning-text text-[20px]">warning</span>
            </div>
            <p class="font-body-sm text-body-sm font-medium">
              <strong class="font-bold">Datos provisionales 2027:</strong> Los festivos autonómicos se actualizan conforme se publiquen en los boletines oficiales.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-space-sm mb-space-sm">
          <span class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center text-on-primary font-bold text-sm font-display">{sigla}</span>
          <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
              Festivos {nombre} 2027
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Días laborables, hábiles y festivos en {nombre} para el año 2027
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Summary KPI Cards -->
    <section class="max-w-[72rem] mx-auto px-gutter-desktop pb-space-2xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md mb-space-xl">
        <!-- Laborables -->
        <div class="bg-surface-card border border-border-subtle rounded-xl p-space-lg shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <span class="font-label-md text-label-md text-text-secondary uppercase tracking-wider block">Días laborables</span>
            <span class="font-caption-legal text-caption-legal text-text-muted mt-0.5 block">Lunes a viernes no festivos</span>
          </div>
          <div class="my-space-md">
            <span class="text-metric-display-mobile md:text-metric-display text-on-surface tracking-tight font-display">{resultado.diasLaborables}</span>
          </div>
          <p class="font-body-sm text-body-sm text-text-secondary">Jornadas laborales en {nombre}</p>
        </div>

        <!-- Hábiles -->
        <div class="bg-surface-card border-2 border-primary-container/40 rounded-xl p-space-lg shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 right-0 w-24 h-24 bg-primary-fixed/30 rounded-bl-full pointer-events-none"></div>
          <div class="flex items-start justify-between relative z-10">
            <div>
              <span class="font-label-md text-label-md text-primary font-bold uppercase tracking-wider block">Días hábiles</span>
              <span class="font-caption-legal text-caption-legal text-text-muted mt-0.5 block">Incluye sábados no festivos</span>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-primary-container text-on-primary font-label-sm text-label-sm font-bold inline-flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">gavel</span> Ley 39/2015
            </span>
          </div>
          <div class="my-space-md relative z-10">
            <span class="text-metric-display-mobile md:text-metric-display text-primary tracking-tight font-display">{resultado.diasHabiles}</span>
          </div>
          <p class="font-body-sm text-body-sm text-on-surface-variant relative z-10">
            Para plazos administrativos en {nombre}
          </p>
        </div>

        <!-- Festivos -->
        <div class="bg-surface-card border border-border-subtle rounded-xl p-space-lg shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <span class="font-label-md text-label-md text-text-secondary uppercase tracking-wider block">Festivos totales</span>
            <span class="font-caption-legal text-caption-legal text-text-muted mt-0.5 block">Nacionales + autonómicos</span>
          </div>
          <div class="my-space-md">
            <span class="text-metric-display-mobile md:text-metric-display text-on-surface tracking-tight font-display">{festivos.length}</span>
          </div>
          <p class="font-body-sm text-body-sm text-text-secondary">
            {festivosAutonomicos.length} festivos autonómicos de {nombre}
          </p>
        </div>
      </div>

      <p class="font-caption-legal text-caption-legal text-text-muted mb-space-xl">
        Año completo (1 enero – 31 diciembre 2027). Los sábados cuentan como días hábiles (Ley 39/2015).
      </p>

      <!-- CTA to Calculator -->
      <div class="bg-surface-container-low rounded-xl p-space-lg border border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-space-sm mb-space-2xl">
        <div class="flex items-center gap-space-sm">
          <div class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center text-on-primary shrink-0">
            <span class="material-symbols-outlined">calculate</span>
          </div>
          <div>
            <span class="font-label-md text-label-md text-on-surface font-bold">Calculadora personalizada</span>
            <p class="font-caption-legal text-caption-legal text-on-surface-variant">Calcula días laborables con festivos de {nombre} en fechas concretas</p>
          </div>
        </div>
        <a href={`/?comunidad=${id}`} class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-bold transition-all shadow-md hover:shadow-lg">
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          Ir a la calculadora
        </a>
      </div>

      <!-- National Holidays -->
      <div class="mb-space-2xl">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-space-md flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-error-container text-on-error-container flex items-center justify-center text-xs font-bold">
            <span class="material-symbols-outlined text-[16px]">flag</span>
          </span>
          Festivos nacionales
        </h2>
        <div class="bg-surface-card rounded-xl border border-border-subtle shadow-sm divide-y divide-border-subtle">
          {soloNacionales.festivosEnRango.map(f => (
            <div class="flex items-center gap-space-sm p-space-md">
              <span class="w-2 h-2 rounded-full bg-error shrink-0"></span>
              <div class="flex-1">
                <span class="font-label-md text-label-md text-on-surface font-semibold">
                  {new Date(f.fecha + 'T00:00:00').toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' })}
                </span>
                <span class="text-text-muted mx-1">—</span>
                <span class="font-body-md text-body-md text-on-surface-variant">{f.nombre}</span>
              </div>
              <span class="text-[10px] px-1.5 py-0.5 bg-error-container text-on-error-container rounded font-bold uppercase">Nacional</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Regional Holidays -->
      <div class="mb-space-2xl">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-space-md flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-primary-container text-on-primary flex items-center justify-center text-xs font-bold">
            <span class="material-symbols-outlined text-[16px]">location_on</span>
          </span>
          Festivos autonómicos de {nombre}
        </h2>
        {festivosAutonomicos.length > 0 ? (
          <div class="bg-surface-card rounded-xl border border-border-subtle shadow-sm divide-y divide-border-subtle">
            {festivosAutonomicos.map(f => (
              <div class="flex items-center gap-space-sm p-space-md">
                <span class="w-2 h-2 rounded-full bg-status-warning shrink-0"></span>
                <div class="flex-1">
                  <span class="font-label-md text-label-md text-on-surface font-semibold">
                    {new Date(f.fecha + 'T00:00:00').toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' })}
                  </span>
                  <span class="text-text-muted mx-1">—</span>
                  <span class="font-body-md text-body-md text-on-surface-variant">{f.nombre}</span>
                  {f.nota && <span class="font-caption-legal text-caption-legal text-text-muted"> ({f.nota})</span>}
                </div>
                <span class="text-[10px] px-1.5 py-0.5 bg-surface-container text-secondary rounded font-bold uppercase">Autonómico</span>
              </div>
            ))}
          </div>
        ) : (
          <div class="bg-surface-card rounded-xl border border-border-subtle shadow-sm p-space-lg text-center">
            <p class="font-body-md text-body-md text-on-surface-variant">No hay festivos autonómicos específicos registrados para {nombre} en este momento.</p>
          </div>
        )}
      </div>

      <!-- What are laborable vs hábil -->
      <div class="bg-surface-card p-space-lg rounded-xl border border-border-subtle shadow-sm mb-space-xl">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-space-md">¿Qué son los días laborables y hábiles?</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
          <div class="p-space-md bg-surface-container-low rounded-lg">
            <h3 class="font-label-md text-label-md text-tertiary font-bold mb-space-xs">Día laborable</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Lunes a viernes que no es festivo. Es el concepto empleado en contratos de empleo, convenios colectivos y nóminas.
            </p>
          </div>
          <div class="p-space-md bg-primary-fixed/10 rounded-lg border-l-4 border-primary">
            <h3 class="font-label-md text-label-md text-primary font-bold mb-space-xs">Día hábil</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Lunes a viernes + sábados no festivos. En plazos administrativos (Ley 39/2015) se cuentan días hábiles.
            </p>
          </div>
        </div>
        <p class="font-caption-legal text-caption-legal text-text-muted mt-space-md">
          En plazos administrativos se cuentan días hábiles (incluyendo sábados) salvo que la norma diga expresamente "laborables".
          <a href="/dias-habiles/" class="text-primary hover:underline">Más información →</a>
        </p>
      </div>

      <!-- All communities link -->
      <div class="bg-surface-container-low rounded-xl p-space-lg border border-border-subtle text-center">
        <p class="font-body-md text-body-md text-on-surface-variant mb-space-sm">¿Necesitas calcular días laborables en otra comunidad?</p>
        <a href="/" class="inline-flex items-center gap-2 px-space-md py-2.5 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-bold transition-all shadow-md">
          Ver todas las comunidades y ciudades
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="w-full bg-surface-container-low mt-space-3xl py-space-2xl">
    <div class="max-w-[72rem] mx-auto px-gutter-desktop">
      <div class="border-t border-border-subtle pt-space-lg flex flex-col md:flex-row items-center justify-between gap-space-sm">
        <p class="font-caption-legal text-caption-legal text-text-muted">
          © 2027 diashabiles.es — Plataforma de referencia para el cómputo de plazos laborales y administrativos en España.
        </p>
        <p class="font-caption-legal text-caption-legal text-text-muted">
          Los datos de festivos son provisionales hasta la publicación oficial en el BOE.
        </p>
      </div>
    </div>
  </footer>
</Layout>
