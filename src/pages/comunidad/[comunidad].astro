---
import Layout from '../../layouts/Layout.astro';
import { calcularDias, COMUNIDADES } from '../../lib/calculadora';

export function getStaticPaths() {
  return COMUNIDADES.map(c => ({
    params: { comunidad: c.id },
    props: { nombre: c.nombre, id: c.id },
  }));
}

const { nombre, id } = Astro.props;

// Calcular festivos del año completo
const resultado = calcularDias('2027-01-01', '2027-12-31', id);
const festivos = resultado.festivosEnRango;

// Festivos nacionales (sin comunidad)
const soloNacionales = calcularDias('2027-01-01', '2027-12-31');
---

<Layout
  title={`Días laborables y festivos ${nombre} 2027 — diashabiles.es`}
  description={`Calcula los días laborables y hábiles en ${nombre} para 2027. Festivos nacionales y autonómicos. Herramienta gratuita.`}
>
  <Fragment slot="json-ld">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": `Días laborables ${nombre} 2027`,
      "url": `https://diashabiles.es/comunidad/${id}`,
      "description": `Festivos nacionales y autonómicos de ${nombre} en 2027`,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://diashabiles.es" },
          { "@type": "ListItem", "position": 2, "name": `${nombre}`, "item": `https://diashabiles.es/comunidad/${id}` }
        ]
      }
    }
    </script>
  </Fragment>

  <header>
    <nav style="font-size: 0.85rem; color: var(--color-muted); margin-bottom: 1rem;">
      <a href="/" style="color: var(--color-primary); text-decoration: none;">Inicio</a> → {nombre}
    </nav>
    <h1>Festivos {nombre} 2027</h1>
    <p>Días laborables, hábiles y festivos en {nombre} para el año 2027</p>
  </header>

  <div class="provisional">
    ⚠️ <strong>Datos provisionales.</strong> El BOE de festivos 2027 se publica en octubre. Los festivos autonómicos son orientativos.
  </div>

  <section class="summary">
    <div class="summary-grid">
      <div class="summary-item">
        <span class="number">{resultado.diasLaborables}</span>
        <span class="label">Días laborables</span>
      </div>
      <div class="summary-item">
        <span class="number">{resultado.diasHabiles}</span>
        <span class="label">Días hábiles</span>
      </div>
      <div class="summary-item">
        <span class="number">{festivos.length}</span>
        <span class="label">Festivos</span>
      </div>
    </div>
    <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--color-muted);">
      Año completo (1 enero – 31 diciembre 2027). Los sábados cuentan como días hábiles (Ley 39/2015).
    </p>
  </section>

  <section style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Calcular con otros datos</h2>
    <p style="font-size: 0.9rem; color: var(--color-muted); margin-bottom: 0.5rem;">
      Usa la calculadora para fechas personalizadas con festivos de {nombre}:
    </p>
    <a href={`/?comunidad=${id}`} class="cta">Ir a la calculadora con {nombre} →</a>
  </section>

  <section style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">Festivos en {nombre} 2027</h2>

    <h3 style="font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--color-primary);">Festivos nacionales</h3>
    <ul class="festivos-list">
      {soloNacionales.festivosEnRango.map(f => (
        <li>
          <strong>{new Date(f.fecha + 'T00:00:00').toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' })}</strong>
          — {f.nombre}
        </li>
      ))}
    </ul>

    <h3 style="font-size: 0.95rem; margin-top: 1.5rem; margin-bottom: 0.5rem; color: var(--color-primary);">Festivos autonómicos de {nombre}</h3>
    <ul class="festivos-list">
      {festivos.filter(f => !soloNacionales.festivosEnRango.some(n => n.fecha === f.fecha)).map(f => (
        <li>
          <strong>{new Date(f.fecha + 'T00:00:00').toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' })}</strong>
          — {f.nombre}
          {f.nota && <span style="font-size: 0.85rem; color: var(--color-muted);"> ({f.nota})</span>}
        </li>
      ))}
    </ul>
  </section>

  <section style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">¿Qué son los días laborables y hábiles?</h2>
    <p style="font-size: 0.9rem; margin-bottom: 0.5rem;">
      <strong>Día laborable</strong> = lunes a viernes que no es festivo.
    </p>
    <p style="font-size: 0.9rem; margin-bottom: 0.5rem;">
      <strong>Día hábil</strong> = lunes a viernes que no es festivo <strong>+ sábados no festivos</strong>.
    </p>
    <p style="font-size: 0.85rem; color: var(--color-muted);">
      En plazos administrativos se cuentan días hábiles (incluyendo sábados) salvo que la norma diga expresamente "laborables".
      <a href="/dias-habiles" style="color: var(--color-primary);">Más información →</a>
    </p>
  </section>

  <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.5rem; text-align: center;">
    <p style="margin-bottom: 0.75rem;">¿Necesitas calcular días laborables en otra comunidad?</p>
    <a href="/" style="color: var(--color-primary); font-weight: 600;">Ver todas las comunidades y ciudades →</a>
  </div>

  <footer>
    <p>diashabiles.es — Festivos nacionales y autonómicos 2027 (provisionales)</p>
  </footer>

  <style>
    .summary {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      text-align: center;
    }
    .summary-item .number {
      display: block;
      font-size: 2rem;
      font-weight: 700;
      color: var(--color-primary);
    }
    .summary-item .label {
      font-size: 0.8rem;
      color: var(--color-muted);
    }
    .festivos-list {
      list-style: none;
      padding: 0;
      font-size: 0.9rem;
    }
    .festivos-list li {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--color-border);
    }
    .festivos-list li:last-child {
      border-bottom: none;
    }
    .cta {
      display: inline-block;
      background: var(--color-primary);
      color: #fff;
      padding: 0.6rem 1.2rem;
      border-radius: var(--radius);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      transition: background 0.2s;
    }
    .cta:hover {
      background: var(--color-primary-hover);
    }
    @media (max-width: 480px) {
      .summary-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
