      "author": { "@type": "Person", "name": "Carlos Méndez" },
      "datePublished": "2026-09-15",
      "dateModified": "2026-09-15",
      "publisher": {
        "@type": "Organization",
        "name": "diashabiles.es",
        "url": "https://diashabiles.es"
      },
