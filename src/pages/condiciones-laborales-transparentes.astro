const description = "El Real Decreto 723/2026 ya está en el BOE. Te explicamos qué información obligatoria debe incluir ahora tu contrato de trabajo y qué derechos tienes como trabajador.";
---

<Layout title={title} description={description}>
  <Fragment slot="json-ld">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Condiciones laborales transparentes: lo que cambia con el nuevo Real Decreto",
