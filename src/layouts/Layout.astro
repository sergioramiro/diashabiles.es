---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const canonicalUrl = canonical || `https://diashabiles.es${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="es_ES" />

  <!-- JSON-LD -->
  <slot name="json-ld" />

  <style is:global>
    :root {
      --color-bg: #fafafa;
      --color-text: #1a1a1a;
      --color-primary: #2563eb;
      --color-primary-hover: #1d4ed8;
      --color-border: #e5e7eb;
      --color-surface: #ffffff;
      --color-muted: #6b7280;
      --color-success: #059669;
      --radius: 8px;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --color-bg: #111111;
        --color-text: #e5e5e5;
        --color-primary: #60a5fa;
        --color-primary-hover: #93bbfd;
        --color-border: #333;
        --color-surface: #1a1a1a;
        --color-muted: #9ca3af;
        --color-success: #34d399;
      }
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      min-height: 100vh;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    header {
      text-align: center;
      margin-bottom: 2rem;
    }

    header h1 {
      font-size: 1.75rem;
      margin-bottom: 0.5rem;
    }

    header p {
      color: var(--color-muted);
      font-size: 0.95rem;
    }

    .calculator {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.25rem;
      font-size: 0.9rem;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 0.6rem 0.75rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      font-size: 1rem;
      background: var(--color-bg);
      color: var(--color-text);
    }

    .form-group input:focus,
    .form-group select:focus {
      outline: 2px solid var(--color-primary);
      outline-offset: 1px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    @media (max-width: 480px) {
      .form-row {
        grid-template-columns: 1fr;
      }
    }

    button[type="submit"] {
      width: 100%;
      padding: 0.75rem;
      background: var(--color-primary);
      color: white;
      border: none;
      border-radius: var(--radius);
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }

    button[type="submit"]:hover {
      background: var(--color-primary-hover);
    }

    .results {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .results h2 {
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }

    .result-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      text-align: center;
    }

    @media (max-width: 480px) {
      .result-grid {
        grid-template-columns: 1fr;
      }
    }

    .result-item {
      padding: 0.75rem;
      background: var(--color-bg);
      border-radius: var(--radius);
    }

    .result-item .number {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-primary);
    }

    .result-item .label {
      font-size: 0.8rem;
      color: var(--color-muted);
      margin-top: 0.25rem;
    }

    .festivos-list {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }

    .festivos-list h3 {
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
    }

    .festivos-list ul {
      list-style: none;
      font-size: 0.85rem;
    }

    .festivos-list li {
      padding: 0.25rem 0;
      color: var(--color-muted);
    }

    .festivos-list li::before {
      content: "🔴 ";
    }

    footer {
      text-align: center;
      padding: 2rem 0;
      color: var(--color-muted);
      font-size: 0.8rem;
    }

    footer a {
      color: var(--color-primary);
      text-decoration: none;
    }

    .provisional {
      background: #fef3c7;
      color: #92400e;
      padding: 0.75rem 1rem;
      border-radius: var(--radius);
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      border: 1px solid #fde68a;
    }

    @media (prefers-color-scheme: dark) {
      .provisional {
        background: #422006;
        color: #fbbf24;
        border-color: #92400e;
      }
    }

    .hidden { display: none; }
  </style>
  <!-- Umami Analytics -->
  <script defer src="https://carter-investment-duration-renaissance.trycloudflare.com/script.js" data-website-id="1832ac16-6a0f-42b0-915b-f39c1ec31342"></script>
</head>
<body>
  <div class="container">
    <slot />
  </div>
  <script is:inline src="/hide-netlify-badge.js"></script>
</body>
</html>
