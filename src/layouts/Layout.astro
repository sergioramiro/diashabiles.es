---
import '../styles/global.css';
import Header from '../components/Header.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const canonicalUrl = canonical || `https://diashabiles.es${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:image" content="https://diashabiles.es/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="diashabiles.es — Calcula días laborables en España" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://diashabiles.es/og-image.png" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#2563EB" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />

  <!-- Google Fonts: Plus Jakarta Sans - Preload for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" as="style" fetchpriority="high" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" /></noscript>

  <!-- Material Symbols - Self-hosted (local, no Google Fonts dependency) -->
  <link rel="preload" href="/fonts/MaterialSymbolsOutlined.woff2" as="font" type="font/woff2" crossorigin />

  <!-- JSON-LD -->
  <slot name="json-ld" />

  <!-- Umami Analytics -->
  <script defer src="https://analytics.diashabiles.es/script.js" data-website-id="1832ac16-6a0f-42b0-915b-f39c1ec31342"></script>

  <!-- Medición de uso de la calculadora y de los CTA desde artículos (sin datos personales) -->
  <script is:inline>
    (function () {
      function track(evento, datos) {
        try {
          if (window.umami && typeof window.umami.track === 'function') window.umami.track(evento, datos);
        } catch (e) {}
      }

      function origen() {
        try {
          var ref = document.referrer || '';
          if (!ref) return 'directo';
          var u = new URL(ref);
          if (u.hostname !== location.hostname) return 'externo';
          var p = u.pathname.replace(/^\/|\/$/g, '');
          return p || 'home';
        } catch (e) { return 'desconocido'; }
      }

      function bandaDias(n) {
        if (!isFinite(n) || n <= 0) return 'sin-dias';
        if (n <= 7) return 'hasta-7';
        if (n <= 30) return '8-30';
        if (n <= 90) return '31-90';
        if (n <= 365) return '91-365';
        return 'mas-de-365';
      }

      // CTA hacia la calculadora desde cualquier página que no sea la home
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href*="#calculadora"]') : null;
        if (!a) return;
        var pagina = location.pathname.replace(/^\/|\/$/g, '') || 'home';
        if (pagina === 'home') return;
        track('cta-calculadora', { articulo: pagina });
      }, true);

      var cont = document.getElementById('calculadora');
      if (!cont) return;

      var interactuo = false;
      var enviado = false;
      var inicial = null;
      var t = null;

      function leerDias() {
        var el = document.getElementById('kpi-laborables');
        if (!el) return -1;
        var m = (el.textContent || '').replace(/\s/g, '').match(/-?\d+/);
        return m ? parseInt(m[0], 10) : -1;
      }

      function comunidad() {
        var sel = document.getElementById('selector-ccaa');
        var v = sel && sel.value ? String(sel.value) : '';
        return v || 'nacional';
      }

      function comprobar() {
        if (!interactuo || enviado) return;
        var n = leerDias();
        if (n < 0) return;
        if (inicial === null) { inicial = n; return; }
        if (n === inicial) return;
        enviado = true;
        track('resultado-calculadora', {
          origen: origen(),
          dias: bandaDias(n),
          comunidad: comunidad()
        });
      }

      function primeraInteraccion() {
        if (interactuo) return;
        inicial = leerDias();
        interactuo = true;
        track('interaccion-calculadora', { origen: origen() });
      }

      ['input', 'change'].forEach(function (ev) {
        cont.addEventListener(ev, function (e) {
          if (!e.target || e.target.id === 'btn-calcular') return;
          primeraInteraccion();
          clearTimeout(t);
          t = setTimeout(comprobar, 600);
        }, true);
      });

      cont.addEventListener('click', function (e) {
        var b = e.target && e.target.closest ? e.target.closest('button') : null;
        if (!b) return;
        primeraInteraccion();
        clearTimeout(t);
        t = setTimeout(comprobar, 600);
      }, true);

      var kpi = document.getElementById('kpi-laborables');
      if (kpi && window.MutationObserver) {
        new MutationObserver(function () {
          if (!interactuo) return;
          clearTimeout(t);
          t = setTimeout(comprobar, 300);
        }).observe(kpi, { childList: true, characterData: true, subtree: true });
      }
    })();
  </script>
</head>
<body class="bg-surface font-body text-body-md text-on-surface antialiased">
  <Header />
  <div class="h-16"></div>
  <slot />
</body>
</html>
